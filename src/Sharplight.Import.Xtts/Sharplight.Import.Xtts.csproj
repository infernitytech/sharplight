<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>XTTS v2 importer for Sharplight: reads Coqui's XTTS v2 text-to-speech checkpoint (GPT-2 audio-token model, HiFi-GAN decoder, built-in speakers) into Sharplight speech-synthesis models.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Sharplight.Core/Sharplight.Core.csproj" />
    <ProjectReference Include="../Sharplight.Import.PyTorch/Sharplight.Import.PyTorch.csproj" />
    <ProjectReference Include="../Sharplight.Import.HuggingFace/Sharplight.Import.HuggingFace.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Sharplight.TextToSpeech.Tests" />
  </ItemGroup>
</Project>
