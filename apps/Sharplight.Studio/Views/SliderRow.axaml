<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Sharplight.Studio.Views"
             x:Class="Sharplight.Studio.Views.SliderRow"
             x:DataType="views:SliderRow">
  <StackPanel>
    <DockPanel>
      <TextBlock DockPanel.Dock="Right" x:Name="ValueText" Classes="caption mono" />
      <TextBlock x:Name="LabelText" Classes="label" />
    </DockPanel>
    <Slider x:Name="Slider" Margin="0,-6,0,-6" />
  </StackPanel>
</UserControl>
