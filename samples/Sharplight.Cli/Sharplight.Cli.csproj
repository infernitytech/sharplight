<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The assembly cannot be called "sharplight": assembly names compare case-insensitively, so it would shadow the Sharplight
         library. The command stays "sharplight": a copy of the app host under that name (it starts Sharplight.Cli.dll). -->
    <AssemblyName>Sharplight.Cli</AssemblyName>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <!-- Image file decoding lives in samples only; the libraries take raw RGB pixels. -->
    <PackageReference Include="StbImageSharp" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Sharplight.Samples.Common/Sharplight.Samples.Common.csproj" />
    <ProjectReference Include="../Sharplight.Samples.Hub/Sharplight.Samples.Hub.csproj" />
    <ProjectReference Include="../../src/Sharplight.Core/Sharplight.Core.csproj" />
    <ProjectReference Include="../../src/Sharplight.Metal/Sharplight.Metal.csproj" />
    <ProjectReference Include="../../src/Sharplight.Vulkan/Sharplight.Vulkan.csproj" />
    <ProjectReference Include="../../src/Sharplight.Cpu/Sharplight.Cpu.csproj" />
  </ItemGroup>
  <Target Name="CopySharplightCommand" AfterTargets="Build" Condition="Exists('$(OutDir)$(AssemblyName)$(_NativeExecutableExtension)')">
    <Copy SourceFiles="$(OutDir)$(AssemblyName)$(_NativeExecutableExtension)" DestinationFiles="$(OutDir)sharplight$(_NativeExecutableExtension)" SkipUnchangedFiles="true" />
  </Target>
</Project>
