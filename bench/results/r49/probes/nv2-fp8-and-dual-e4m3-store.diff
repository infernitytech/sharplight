+// ---------------------------------------------------------------------------------------------
+// PROBE: FP8 GEMM on workgroup-scope cooperative matrices (VK_NV_cooperative_matrix2): the driver stages the E4M3 tiles.
+#ifndef NV_BT
+#define NV_BT 128
+#endif
+#ifndef NV_BN
+#define NV_BN 128
+#endif
+#ifndef NV8_BK
+#define NV8_BK 128
+#endif
+typealias Nv8A = CoopMat<FloatE4M3, MemoryScope.Workgroup, NV_BT, NV8_BK, CoopMatMatrixUse.MatrixA>;
+typealias Nv8B = CoopMat<FloatE4M3, MemoryScope.Workgroup, NV8_BK, NV_BN, CoopMatMatrixUse.MatrixB>;
+typealias Nv8C = CoopMat<float, MemoryScope.Workgroup, NV_BT, NV_BN, CoopMatMatrixUse.MatrixAccumulator>;
+// Three buffers: step s writes the scales of step s + 1 while slower invocations may still read those of step s - 1.
+groupshared float nvXs[3][NV_BT];
+groupshared float nvWs[3][NV_BN];
+
+struct Nv8Scale : IFunc<float, uint32_t, uint32_t, float>
+{
+    uint buf;
+    float operator()(uint32_t r, uint32_t c, float v)
+    {
+        return v * (nvXs[buf][r] * nvWs[buf][c]);
+    }
+}
