<Project Sdk="Microsoft.NET.Sdk">
  <!-- Batched-decode micro benchmark (not part of Sharplight.slnx): per-step latency of the multi-sequence decoder vs batch size. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <WarningsAsErrors></WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Sharplight.Llm/Sharplight.Llm.csproj" />
    <ProjectReference Include="../../src/Sharplight.Vulkan/Sharplight.Vulkan.csproj" />
    <ProjectReference Include="../../src/Sharplight.Gguf/Sharplight.Gguf.csproj" />
    <ProjectReference Include="../../src/Sharplight.Package/Sharplight.Package.csproj" />
  </ItemGroup>
</Project>
