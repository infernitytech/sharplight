<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:se="using:Sharplight.Studio.ViewModels.Search"
             xmlns:iv="using:Sharplight.Studio.Views.Inference"
             xmlns:vmi="using:Sharplight.Studio.ViewModels"
             xmlns:v="using:Sharplight.Studio.Views"
             x:Class="Sharplight.Studio.Views.SearchPage"
             x:DataType="se:SearchPageViewModel">
  <iv:InferenceFrame>
    <iv:InferenceFrame.Workspace>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14">
          <!-- Folder -->
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Classes="h2" Text="Documents" />
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                  <Button Classes="small" Content="Choose folder" Command="{Binding ChooseFolderCommand}" />
                  <Button Classes="accent small" Content="Index" Command="{Binding IndexCommand}" />
                  <Button Classes="small" Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsWorking}" />
                </StackPanel>
                <TextBox Text="{Binding FolderPath}" PlaceholderText="Folder with PDF, Word, PowerPoint, Excel, Markdown, HTML, text and source files" />
              </DockPanel>
              <CheckBox IsChecked="{Binding WatchFolder}" Content="Keep the index up to date while this page is open"
                        ToolTip.Tip="Watches the folder and re-embeds only the files that changed, were added or removed." />
              <TextBlock Classes="caption" Text="{Binding IndexSummary}" TextWrapping="Wrap" IsVisible="{Binding HasIndex}" />
              <TextBlock Classes="caption" Text="{Binding RunHint}" TextWrapping="Wrap" IsVisible="{Binding RunHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Classes="caption" Text="{Binding Notice}" TextWrapping="Wrap" IsVisible="{Binding HasNotice}" />
            </StackPanel>
          </Border>
          <!-- Question -->
          <Border Grid.Row="1" Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Classes="h2" Text="Question" />
              <StackPanel IsVisible="{Binding CanRerank}" Spacing="4">
                <TextBlock Classes="label" Text="Reranking model (used when Rerank results is on)" />
                <ComboBox ItemsSource="{Binding Rerankers.Models}" SelectedItem="{Binding Rerankers.SelectedModel}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vmi:ModelOptionViewModel">
                      <TextBlock Text="{Binding Id}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel IsVisible="{Binding CanAskModel}" Spacing="4">
                <TextBlock Classes="label" Text="Chat model (answers Ask from the passages)" />
                <ComboBox ItemsSource="{Binding ChatModels.Models}" SelectedItem="{Binding ChatModels.SelectedModel}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vmi:ModelOptionViewModel">
                      <TextBlock Text="{Binding Id}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                  <Button Classes="accent" Content="Search" Command="{Binding SearchCommand}" />
                  <Button Content="Ask" Command="{Binding AskCommand}" IsVisible="{Binding CanAskModel}" ToolTip.Tip="Answer the question from the top passages with the chat model, citing them" />
                </StackPanel>
                <TextBox Text="{Binding Query}" PlaceholderText="Ask about the documents" AcceptsReturn="False" />
              </DockPanel>
            </StackPanel>
          </Border>
          <!-- Answer -->
          <Border Grid.Row="2" Classes="card" IsVisible="{Binding HasAnswer}">
            <StackPanel Spacing="8">
              <TextBlock Classes="h2" Text="Answer" />
              <SelectableTextBlock Text="{Binding Answer}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding AnswerCitations}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="se:SearchResultViewModel">
                    <Button Classes="ghost small" Margin="0,0,6,0" ToolTip.Tip="Show the passage below"
                            Command="{Binding $parent[ItemsControl].((se:SearchPageViewModel)DataContext).FocusResultCommand}" CommandParameter="{Binding}">
                      <TextBlock Text="{Binding Citation}" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <!-- Results -->
          <Border Grid.Row="3" Classes="card" ClipToBounds="True">
            <Grid RowDefinitions="Auto,Auto,Auto">
              <TextBlock Classes="h2" Text="Passages" Margin="0,0,0,10" />
              <Panel Grid.Row="1" MinHeight="160" ClipToBounds="True">
                <StackPanel IsVisible="{Binding !HasResults}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                  <Path Classes="icon huge" Data="{StaticResource IconSearch}" HorizontalAlignment="Center" />
                  <TextBlock Classes="muted" Text="The closest passages appear here, best first." HorizontalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Results}" IsVisible="{Binding HasResults}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="se:SearchResultViewModel">
                        <Border Classes="inset" Classes.focused="{Binding IsFocused}" Padding="12,10" Margin="0,0,0,8">
                          <StackPanel Spacing="6">
                            <DockPanel>
                              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                <Button Classes="ghost small" Content="Open" ToolTip.Tip="Open the document at this page or line (in the system's default program)"
                                        Command="{Binding $parent[ItemsControl].((se:SearchPageViewModel)DataContext).OpenResultCommand}" CommandParameter="{Binding}" />
                                <Button Classes="ghost small" Content="Copy" ToolTip.Tip="Copy the passage"
                                        Command="{Binding $parent[ItemsControl].((se:SearchPageViewModel)DataContext).CopyResultCommand}" CommandParameter="{Binding}" />
                              </StackPanel>
                              <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding NumberText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Border Classes="badge accent">
                                  <TextBlock Text="{Binding ScoreText}" />
                                </Border>
                                <TextBlock Text="{Binding FileName}" FontWeight="Medium" TextTrimming="CharacterEllipsis" MaxWidth="360" VerticalAlignment="Center" />
                                <TextBlock Classes="caption" Text="{Binding Location}" TextTrimming="CharacterEllipsis" MaxWidth="240" VerticalAlignment="Center"
                                           IsVisible="{Binding Location, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                              </StackPanel>
                            </DockPanel>
                            <ProgressBar Classes="thin" Minimum="0" Maximum="1" Value="{Binding ScoreFraction}" />
                            <v:HighlightedTextBlock Segments="{Binding Segments}" TextWrapping="Wrap" FontSize="13" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Panel>
              <TextBlock Grid.Row="2" Classes="caption" Text="{Binding ResultSummary}" Margin="0,8,0,0" TextWrapping="Wrap" />
            </Grid>
          </Border>
        </Grid>
      </ScrollViewer>
    </iv:InferenceFrame.Workspace>
  </iv:InferenceFrame>
</UserControl>
