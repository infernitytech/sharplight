<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Model feed for Sharplight: package manifests, a static signed feed index (paged JSON with a digest chain, rollback and freeze protection), a feed client (HTTP or folder) with signature verification, dependency resolution by semantic version and resumable, chunk-verified package downloads, and the feed publisher. Register with services.AddModelFeed().</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Sharplight.ModelFeed.Tests" />
  </ItemGroup>
</Project>
