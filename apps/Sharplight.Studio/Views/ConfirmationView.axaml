<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvm="using:Sharplight.Studio.ViewModels.Models"
             x:Class="Sharplight.Studio.Views.ConfirmationView"
             x:DataType="mvm:ConfirmationViewModel">
  <Border Classes="card" Padding="14,10" Margin="0,0,0,10" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
    <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="14,0,0,0">
        <Button x:Name="CancelButton" Classes="small" Content="Cancel" Command="{Binding CancelCommand}" />
        <Button x:Name="ConfirmDanger" Classes="small danger" Content="{Binding ConfirmText}" IsVisible="{Binding IsDestructive}" Command="{Binding ConfirmCommand}" />
        <Button x:Name="ConfirmSafe" Classes="small accent" Content="{Binding ConfirmText}" IsVisible="{Binding !IsDestructive}" Command="{Binding ConfirmCommand}" />
      </StackPanel>
      <TextBlock x:Name="MessageText" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
    </DockPanel>
  </Border>
</UserControl>
