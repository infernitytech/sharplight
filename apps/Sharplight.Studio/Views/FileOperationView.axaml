<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvm="using:Sharplight.Studio.ViewModels.Models"
             x:Class="Sharplight.Studio.Views.FileOperationView"
             x:DataType="mvm:FileOperationViewModel">
  <Border Classes="card" Padding="14,10" Margin="0,0,0,10" IsVisible="{Binding IsRunning}">
    <DockPanel>
      <Button DockPanel.Dock="Right" Classes="small" Content="Cancel" Command="{Binding CancelCommand}" Margin="14,0,0,0" VerticalAlignment="Center" />
      <StackPanel Spacing="6" VerticalAlignment="Center">
        <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
        <ProgressBar Classes="thin" Minimum="0" Maximum="1" Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" />
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
