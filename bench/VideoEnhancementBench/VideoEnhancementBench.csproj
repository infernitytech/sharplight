<Project Sdk="Microsoft.NET.Sdk">
  <!-- Video-enhancement benchmark (not part of Sharplight.slnx): median wall time and per-stage split of IVideoEnhancer runs (docs/benchmarks.md). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <WarningsAsErrors></WarningsAsErrors>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Sharplight/Sharplight.csproj" />
    <ProjectReference Include="../../src/Sharplight.Cuda/Sharplight.Cuda.csproj" />
  </ItemGroup>
</Project>
