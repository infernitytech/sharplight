{
  // Feed-only data by package id (docs/model-feed.md "Building a feed"): dependencies between packages, summaries, minimum server
  // versions, languages and listing state. Everything else comes from catalog/verified-models.json.
  "schemaVersion": 1,
  // Defaults for every variant package of a model, by catalog entry id; a package entry below overrides them field by field.
  "models": {
    "qwen3-coder-next": {
      "summary": "Coding agent model from Qwen (80B mixture of experts, 3B active) with tool calls and long context.",
      "languages": ["en", "zh"]
    },
    "qwen3.8-flash-next": {
      "summary": "Qwen's large sparse mixture-of-experts flagship with thinking and non-thinking modes and tool calls.",
      "languages": ["en", "zh", "de", "fr", "es", "it", "pt", "ja", "ko", "ru"]
    },
    "qwen3.5-122b-a10b": {
      "summary": "Qwen3.5 mixture of experts (122B, 10B active) with hybrid linear attention, reasoning, tool calls and image input.",
      "languages": ["en", "zh", "de", "fr", "es", "it", "pt", "ja", "ko", "ru"]
    },
    "qwen3.8-27b": {
      "summary": "Dense 27B Qwen model with hybrid linear attention, thinking and non-thinking modes and tool calls.",
      "languages": ["en", "zh", "de", "fr", "es", "it", "pt", "ja", "ko", "ru"]
    },
    "gemma-4-31b-it": {
      "summary": "Google's dense 31B Gemma 4 instruction model with image input (vision projector included).",
      "languages": ["en", "de", "fr", "es", "it", "pt", "ja", "ko", "zh"]
    },
    "whisper-tiny": {
      "summary": "Smallest multilingual Whisper speech recognition model; long recordings are pre-segmented with the voice activity detector.",
      "dependencies": [
        { "id": "silero-vad-v5.onnx", "range": "[1.0.1,2.0.0)", "kind": "required", "role": "voice-activity" }
      ]
    },
    "gpt-oss-120b": {
      "summary": "OpenAI's open-weight 117B mixture of experts (5.1B active) with configurable reasoning effort and tool calls.",
      "languages": ["en"]
    }
  },
  "packages": {
    "qwen3-0.6b.q8-0-gguf": {
      "summary": "Small multilingual chat model with thinking and non-thinking modes and tool calls.",
      "languages": ["en", "zh", "de", "fr", "es", "it", "pt", "ja", "ko", "ru"]
    },
    "all-minilm-l6-v2.f32-safetensors": {
      "summary": "Compact English sentence embedding model (384 dimensions) for semantic search and clustering.",
      "languages": ["en"],
      "dependencies": [
        { "id": "ms-marco-minilm-l6-v2.f32-safetensors", "range": "[1.0.0,2.0.0)", "kind": "optional", "role": "pairing" }
      ]
    },
    "ms-marco-minilm-l6-v2.f32-safetensors": {
      "summary": "English cross-encoder reranker trained on MS MARCO passage ranking.",
      "languages": ["en"]
    },
    "whisper-tiny.q5-1-whispercpp": {
      "summary": "Smallest multilingual Whisper speech recognition model (whisper.cpp q5_1); long recordings are pre-segmented with the voice activity detector."
    },
    "silero-vad-v5.onnx": {
      // 1.0.0 was built from a community mirror (luvox-ai/silero-vad) of the same file; 1.0.1 (the same package file, official provenance)
      // and later come from Silero's GitHub release, which the whisper packages require.
      "summary": "Voice activity detector (16 kHz) used to segment speech before recognition."
    }
  }
}
