<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <!-- Style rules from docs/code-style.md are build errors (see .editorconfig). -->
    <WarningsAsErrors>$(WarningsAsErrors);IDE0005;IDE0011;IDE0040;IDE0051;IDE0052;IDE0060;IDE0161;CS0169;CS1573;CS1591;CS9113</WarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="'$(OutputType)' != 'Exe'">true</IsAotCompatible>
    <!-- Versions come from version.json and the git height (Nerdbank.GitVersioning, SemVer 2). -->
    <Authors>Sharplight contributors</Authors>
    <Copyright>Copyright (c) Sharplight contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/infernitytech/sharplight</PackageProjectUrl>
    <RepositoryUrl>https://github.com/infernitytech/sharplight</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>llm;inference;gguf;onnx;vulkan;ai;transformers</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <!-- Only the libraries under src/ ship as NuGet packages. -->
  <PropertyGroup Condition="($(MSBuildProjectDirectory.Contains('/src/')) Or $(MSBuildProjectDirectory.Contains('\src\')))">
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup Condition="($(MSBuildProjectDirectory.Contains('/src/')) Or $(MSBuildProjectDirectory.Contains('\src\')))">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)apps/Sharplight.Studio/Assets/Icons/sharplight-studio-128.png" Pack="true" PackagePath="/icon.png" Visible="false" />
  </ItemGroup>
  <!--
    Methods with loops (the CPU kernels) are compiled fully optimized on first use instead of starting as tier-0 code with
    on-stack replacement: otherwise the first runs of a model, and every short benchmark, run unoptimized kernels until
    tiering catches up (a 64-channel 3x3 conv measured 0.66 instead of 0.11 ms). Only executables read this setting.
  -->
  <PropertyGroup>
    <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>
  </PropertyGroup>
  <!-- Tests and samples are not public API: no XML documentation requirement. -->
  <PropertyGroup Condition="($(MSBuildProjectDirectory.Contains('/tests/')) Or $(MSBuildProjectDirectory.Contains('\tests\'))) Or ($(MSBuildProjectDirectory.Contains('/samples/')) Or $(MSBuildProjectDirectory.Contains('\samples\')))">
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
