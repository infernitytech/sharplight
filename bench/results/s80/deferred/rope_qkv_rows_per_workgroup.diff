+[shader("compute")]
+[numthreads(64, 1, 1)]
+void rope_qkv(uint3 gid : SV_GroupID, uint3 ltid : SV_GroupThreadID, uniform QkvParams p)
+{
+    const uint rows = p.T * (HQ + 2 * HK);
+    for (uint r = 0; r < QKV_RPW; r++)
+    {
+        uint row = gid.x * QKV_RPW + r;
+        if (row >= rows) return;
+        rope_qkv_row(p, row, ltid.x);
+    }
