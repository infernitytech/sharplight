<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvm="using:Sharplight.Studio.ViewModels.Models"
             xmlns:models="using:Sharplight.Studio.Models"
             xmlns:views="using:Sharplight.Studio.Views"
             xmlns:conv="using:Sharplight.Studio.Converters"
             x:Class="Sharplight.Studio.Views.LibraryView"
             x:DataType="mvm:LibraryViewModel">
  <Grid x:Name="DropArea" ColumnDefinitions="*,Auto" Margin="0,0,0,16" DragDrop.AllowDrop="True" Background="Transparent">
    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <ComboBox x:Name="KindFilter" ItemsSource="{Binding KindFilters}" SelectedItem="{Binding SelectedKindFilter}" IsVisible="{Binding HasKindFilter}"
                    MinWidth="190" ToolTip.Tip="Show the models of one kind">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="mvm:KindFilterViewModel">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Classes="icon" Data="{Binding Icon, Converter={x:Static conv:IconConverter.Instance}}" Width="13" Height="13" />
                  <TextBlock Text="{Binding Title}" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Classes="small" Command="{Binding RefreshCommand}" ToolTip.Tip="List again">
            <Path Classes="icon" Data="{StaticResource IconRefresh}" Width="13" Height="13" />
          </Button>
          <Button Classes="small" Command="{Binding OpenStoreFolderCommand}" Content="Open folder" />
          <Button Classes="small" Command="{Binding OpenPackageFileCommand}" Content="Open .slm file…" ToolTip.Tip="Inspect a package that is not in the library" />
          <Button Classes="small" Command="{Binding OpenConvertCommand}" Content="Convert…" />
          <Button Classes="accent small" Command="{Binding AddFileCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="icon" Data="{StaticResource IconPlus}" Width="12" Height="12" />
              <TextBlock Text="Add file" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Classes="caption" Text="{Binding StoreRoot, StringFormat='Model store: {0}'}" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="caption" Text="{Binding Status}" />
        </StackPanel>
      </DockPanel>
      <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
        <ComboBox x:Name="SortBox" ItemsSource="{Binding SortChoices}" SelectedItem="{Binding SelectedSort}" MinWidth="170" Margin="0,0,8,6" ToolTip.Tip="Order the models">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="mvm:FilterOption">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ToggleButton x:Name="SelectToggle" Classes="small" Content="Select" IsChecked="{Binding IsSelecting}" Margin="0,0,8,6" ToolTip.Tip="Tick models for a bulk action" />
        <Button x:Name="ImportFile" Classes="small" Content="Import .slm…" Command="{Binding ImportFileCommand}" Margin="0,0,8,6"
                ToolTip.Tip="Add a .slm file to the model store after checking it (or drop files and folders on the library)" />
        <Button x:Name="ImportFolder" Classes="small" Content="Import folder…" Command="{Binding ImportFolderCommand}" Margin="0,0,8,6" />
        <Button x:Name="UpdateAll" Classes="small accent" Command="{Binding UpdateAllCommand}" IsVisible="{Binding HasUpdates}" Margin="0,0,8,6"
                ToolTip.Tip="Download and verify every newer version; each model is replaced only when its update succeeded">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Classes="icon" Data="{StaticResource IconDownload}" Width="12" Height="12" />
            <TextBlock Text="{Binding UpdateAllText}" />
          </StackPanel>
        </Button>
        <Button x:Name="SelectAllButton" Classes="small" Content="Select all" Command="{Binding SelectAllCommand}" IsVisible="{Binding IsSelecting}" Margin="0,0,8,6" />
        <Button x:Name="SelectNoneButton" Classes="small" Content="Select none" Command="{Binding SelectNoneCommand}" IsVisible="{Binding IsSelecting}" Margin="0,0,8,6" />
        <Button x:Name="StripSelected" Classes="small" Content="Remove precompiled" Command="{Binding StripSelectedCommand}" IsVisible="{Binding IsSelecting}" IsEnabled="{Binding HasSelection}" Margin="0,0,8,6"
                ToolTip.Tip="Remove the precompiled artifacts of the ticked models (the models stay)" />
        <Button x:Name="DeleteSelected" Classes="small danger" Command="{Binding DeleteSelectedCommand}" IsVisible="{Binding IsSelecting}" IsEnabled="{Binding HasSelection}" Margin="0,0,8,6">
          <TextBlock>
            <Run Text="Delete" />
            <Run Text="{Binding SelectedCount}" />
            <Run Text="·" />
            <Run Text="{Binding SelectedSize}" />
          </TextBlock>
        </Button>
      </WrapPanel>
      <views:ConfirmationView DockPanel.Dock="Top" DataContext="{Binding Confirmation}" IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <views:FileOperationView DockPanel.Dock="Top" DataContext="{Binding Operation}" />
      <Border DockPanel.Dock="Top" Classes="card" Padding="14,10" Margin="0,0,0,10" IsVisible="{Binding IsUpdatingAll}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="small" Content="Cancel" Command="{Binding CancelUpdateAllCommand}" Margin="14,0,0,0" VerticalAlignment="Center" />
          <StackPanel Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="{Binding UpdateAllStatus}" TextTrimming="CharacterEllipsis" />
            <ProgressBar Classes="thin" Minimum="0" Maximum="1" Value="{Binding UpdateAllProgress}" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Border DockPanel.Dock="Top" Classes="card" Padding="14,10" Margin="0,0,0,10" IsVisible="{Binding HasUnusedSuggestion}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="small" Content="Review" Command="{Binding ReviewUnusedCommand}" Margin="14,0,0,0" VerticalAlignment="Center"
                  ToolTip.Tip="Tick these models so you can delete them" />
          <TextBlock Text="{Binding UnusedSuggestion}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
      <Panel>
        <Border Classes="card" IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
          <StackPanel Spacing="10" HorizontalAlignment="Center">
            <Path Classes="icon huge accent" Data="{StaticResource IconModels}" HorizontalAlignment="Center" />
            <TextBlock Classes="h2" Text="Your library is empty" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" Text="Download a model from Hugging Face, or add a .gguf, .slm or .onnx file." HorizontalAlignment="Center" />
            <Button Classes="accent" Content="Discover models" Command="{Binding OpenDiscoverCommand}" HorizontalAlignment="Center" Margin="0,6,0,0" />
          </StackPanel>
        </Border>
        <TextBlock Classes="muted" IsVisible="{Binding IsFilteredEmpty}" Text="No models of this kind in the library." HorizontalAlignment="Center" VerticalAlignment="Center" />
        <ScrollViewer IsVisible="{Binding !IsEmpty}">
          <ItemsControl ItemsSource="{Binding VisibleEntries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="mvm:LibraryEntryViewModel">
                <Border Classes="card" Margin="0,0,0,10" Padding="16,14">
                  <Border.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Load…" Command="{Binding Library.LoadCommand}" CommandParameter="{Binding}" />
                      <MenuItem Header="Inspect package" IsEnabled="{Binding IsPackage}"
                                Command="{Binding Library.InspectCommand}" CommandParameter="{Binding}" />
                      <MenuItem Header="Precompile for this machine" IsEnabled="{Binding CanPrecompile}"
                                Command="{Binding Library.PrecompileCommand}" CommandParameter="{Binding}" />
                      <MenuItem Header="Export .slm…" IsEnabled="{Binding IsPackage}"
                                Command="{Binding Library.ExportCommand}" CommandParameter="{Binding}" />
                      <MenuItem Header="Export .slm without precompiled…" IsEnabled="{Binding IsPackage}"
                                Command="{Binding Library.ExportLeanCommand}" CommandParameter="{Binding}" />
                      <MenuItem Header="Remove precompiled artifacts" IsEnabled="{Binding IsPrecompiled}"
                                Command="{Binding Library.StripPrecompiledCommand}" CommandParameter="{Binding}" />
                      <MenuItem Header="Open containing folder" Command="{Binding Library.OpenEntryFolderCommand}" CommandParameter="{Binding}" />
                    </ContextMenu>
                  </Border.ContextMenu>
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Border Classes="badge tools" IsVisible="{Binding IsLoaded}">
                        <TextBlock Text="Resident" />
                      </Border>
                      <Button x:Name="FeedUpdate" Classes="small" IsVisible="{Binding HasFeedUpdate}" IsEnabled="{Binding CanUpdateFromFeed}"
                              ToolTip.Tip="Download and verify the newer version from the Sharplight feed; the installed one is replaced only when that succeeded"
                              Command="{Binding $parent[ItemsControl].((mvm:LibraryViewModel)DataContext).UpdateFromFeedCommand}" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Path Classes="icon" Data="{StaticResource IconDownload}" Width="12" Height="12" />
                          <TextBlock Text="{Binding FeedUpdateText}" />
                        </StackPanel>
                      </Button>
                      <Button Classes="small" IsVisible="{Binding IsPackage}" IsEnabled="{Binding CanPrecompile}"
                              ToolTip.Tip="{Binding PrecompileHint}" ToolTip.ShowOnDisabled="True"
                              Command="{Binding $parent[ItemsControl].((mvm:LibraryViewModel)DataContext).PrecompileCommand}" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Path Classes="icon" Data="{StaticResource IconChip}" Width="12" Height="12" />
                          <TextBlock Text="Precompile" />
                        </StackPanel>
                      </Button>
                      <Button Classes="small" IsVisible="{Binding IsPackage}" ToolTip.Tip="Inspect the package: structure, graphs, weights and precompiled kernels"
                              Command="{Binding $parent[ItemsControl].((mvm:LibraryViewModel)DataContext).InspectCommand}" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Path Classes="icon" Data="{StaticResource IconLayers}" Width="12" Height="12" />
                          <TextBlock Text="Inspect" />
                        </StackPanel>
                      </Button>
                      <Button Classes="accent small" IsEnabled="{Binding IsRunnable}" Command="{Binding $parent[ItemsControl].((mvm:LibraryViewModel)DataContext).LoadCommand}" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Path Classes="icon" Data="{StaticResource IconPlay}" Width="11" Height="11" />
                          <TextBlock Text="Load" />
                        </StackPanel>
                      </Button>
                      <Button Classes="ghost icon danger" ToolTip.Tip="Delete (asks first, says how much space it frees)" Command="{Binding $parent[ItemsControl].((mvm:LibraryViewModel)DataContext).DeleteCommand}" CommandParameter="{Binding}">
                        <Path Classes="icon" Data="{StaticResource IconTrash}" Width="13" Height="13" />
                      </Button>
                    </StackPanel>
                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" IsVisible="{Binding $parent[ItemsControl].((mvm:LibraryViewModel)DataContext).IsSelecting}"
                              VerticalAlignment="Top" Margin="0,6,10,0" MinWidth="0" />
                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                      <Path Classes="icon accent" Data="{Binding KindIcon, Converter={x:Static conv:IconConverter.Instance}}" Width="18" Height="18" />
                    </Border>
                    <StackPanel Spacing="4">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14.5" />
                        <TextBlock Classes="caption" Text="{Binding Size}" VerticalAlignment="Center" />
                        <TextBlock Classes="caption" Text="{Binding Context}" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Classes="caption" Text="{Binding Detail}" />
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <Border Classes="badge accent" ToolTip.Tip="{Binding KindToolTip}">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <Path Classes="icon" Data="{Binding KindIcon, Converter={x:Static conv:IconConverter.Instance}}" Width="11" Height="11" />
                            <TextBlock Text="{Binding KindTitle}" />
                          </StackPanel>
                        </Border>
                        <Border Classes="badge warn" IsVisible="{Binding !IsRunnable}" ToolTip.Tip="The engine has no task client for this kind yet">
                          <TextBlock Text="Not yet supported" />
                        </Border>
                        <views:CapabilityBadgesView DataContext="{Binding Badges}" />
                        <Border Classes="badge" IsVisible="{Binding IsPrecompiled}" ToolTip.Tip="{Binding PrecompiledTip}">
                          <TextBlock Text="Precompiled" />
                        </Border>
                        <Border Classes="badge ok" IsVisible="{Binding IsFromFeed}" ToolTip.Tip="Installed from the Sharplight model feed: a signed, preconverted package">
                          <TextBlock Text="{Binding FeedText}" />
                        </Border>
                        <Border Classes="badge" IsVisible="{Binding IsLocalFile}">
                          <TextBlock Text="Local file" />
                        </Border>
                        <TextBlock Classes="caption" Text="{Binding Added}" VerticalAlignment="Center" Margin="4,0,0,0" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="caption" Text="{Binding LastUsedText}" VerticalAlignment="Center" ToolTip.Tip="When the model was last loaded" />
                        <Button Classes="ghost small" Content="Size details" Padding="6,0"
                                Command="{Binding $parent[ItemsControl].((mvm:LibraryViewModel)DataContext).ToggleBreakdownCommand}" CommandParameter="{Binding}"
                                ToolTip.Tip="Where the bytes are: weights, attachments and the precompiled artifacts per provider and device" />
                      </StackPanel>
                      <Border IsVisible="{Binding IsBreakdownOpen}" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                              BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,6,0,0">
                        <StackPanel Spacing="4">
                          <TextBlock Classes="caption" Text="Reading the package…" IsVisible="{Binding IsLoadingBreakdown}" />
                          <ItemsControl ItemsSource="{Binding BreakdownLines}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="mvm:BreakdownLineViewModel">
                                <Grid ColumnDefinitions="260,70,*" Margin="0,2">
                                  <TextBlock Classes="caption" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                  <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Size}" />
                                  <StackPanel Grid.Column="2" Spacing="2">
                                    <ProgressBar Classes="thin" Minimum="0" Maximum="1" Value="{Binding Fraction}" />
                                    <TextBlock Classes="caption" Text="{Binding Detail}" IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
                                  </StackPanel>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                      <Border IsVisible="{Binding HasPrecompileDetails}" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                              BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,6,0,0">
                        <StackPanel Spacing="6">
                          <DockPanel>
                            <Button DockPanel.Dock="Right" Classes="small" Content="Cancel" IsVisible="{Binding IsPrecompiling}" Margin="8,0,0,0"
                                    Command="{Binding $parent[ItemsControl].((mvm:LibraryViewModel)DataContext).CancelPrecompileCommand}" CommandParameter="{Binding}" />
                            <TextBlock Classes="caption" Text="{Binding PrecompileStatus}" TextWrapping="Wrap" VerticalAlignment="Center" />
                          </DockPanel>
                          <ItemsControl ItemsSource="{Binding PrecompileRows}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="mvm:PrecompileRowViewModel">
                                <Grid ColumnDefinitions="280,*" Margin="0,2">
                                  <TextBlock Classes="caption" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                  <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Classes="caption" Text="{Binding Status}" TextWrapping="Wrap" />
                                    <ProgressBar Classes="thin" IsVisible="{Binding IsActive}" IsIndeterminate="{Binding IsIndeterminate}" Minimum="0" Maximum="1"
                                                 Value="{Binding Progress}" />
                                  </StackPanel>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Panel>
    </DockPanel>

    <!-- Side panels -->
    <Border Grid.Column="1" Classes="card" Width="360" Margin="16,0,0,0" IsVisible="{Binding IsPanelOpen}">
      <Panel>
        <views:LoadOptionsView DataContext="{Binding LoadPanel}" IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <views:ConvertView DataContext="{Binding ConvertPanel}" IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </Panel>
    </Border>
  </Grid>
</UserControl>
