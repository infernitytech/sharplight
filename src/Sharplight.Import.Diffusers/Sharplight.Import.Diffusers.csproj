<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Importer for diffusion image models (Stable Diffusion 1.x / 2.x / SDXL, FLUX.1): diffusers folders, single-file safetensors / PyTorch checkpoints, stable-diffusion.cpp / city96 GGUF files and their stand-alone text encoder and VAE files, translated into the canonical model source.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Sharplight.Core/Sharplight.Core.csproj" />
    <ProjectReference Include="../Sharplight.Import.Gguf/Sharplight.Import.Gguf.csproj" />
    <ProjectReference Include="../Sharplight.Import.HuggingFace/Sharplight.Import.HuggingFace.csproj" />
    <ProjectReference Include="../Sharplight.Import.PyTorch/Sharplight.Import.PyTorch.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources/clip-merges.txt.gz" LogicalName="Sharplight.Import.Diffusers.clip-merges.txt.gz" />
    <EmbeddedResource Include="Resources/t5-tokenizer.json.gz" LogicalName="Sharplight.Import.Diffusers.t5-tokenizer.json.gz" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Sharplight.ImageGeneration.Tests" />
  </ItemGroup>
</Project>
