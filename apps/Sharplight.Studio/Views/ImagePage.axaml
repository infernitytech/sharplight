<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:im="using:Sharplight.Studio.ViewModels.Image"
             xmlns:iv="using:Sharplight.Studio.Views.Inference"
             xmlns:conv="using:Sharplight.Studio.Converters"
             xmlns:ga="using:Sharplight.Studio.ViewModels.Gallery"
             xmlns:vw="using:Sharplight.Studio.Views"
             x:Class="Sharplight.Studio.Views.ImagePage"
             x:DataType="im:ImagePageViewModel">
  <iv:InferenceFrame>
    <iv:InferenceFrame.Workspace>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid RowDefinitions="Auto,*" RowSpacing="14" Margin="0,0,10,0">
        <!-- Input -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="Prompt" />
            <TextBox Text="{Binding Prompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="120" VerticalContentAlignment="Top"
                     PlaceholderText="Describe the picture, for example: a lighthouse at dusk, oil painting" />
            <TextBox Text="{Binding NegativePrompt}" TextWrapping="Wrap" PlaceholderText="Negative prompt: what the picture should not show (optional)" />
            <Expander Header="LoRAs" IsVisible="{Binding HasModel}" HorizontalAlignment="Stretch">
              <StackPanel Spacing="6">
                <vw:LoraListView DataContext="{Binding Loras}" />
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding LorasPending}">
                  <Button Classes="small" Content="Apply LoRAs" Command="{Binding ApplyLorasCommand}" ToolTip.Tip="Reloads the model with these LoRAs merged into its weights" />
                  <TextBlock Classes="caption" VerticalAlignment="Center" Text="The model reloads to merge the LoRAs." />
                </StackPanel>
              </StackPanel>
            </Expander>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasRefiners}">
              <TextBlock Classes="caption" Text="Refiner" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding Refiners}" SelectedItem="{Binding SelectedRefiner}" MinWidth="200"
                        ToolTip.Tip="Another loaded image model that finishes the denoising (the SDXL refiner after the SDXL base); the switch point is under Parameters" />
            </StackPanel>
            <Panel IsVisible="{Binding SupportsEditing}">
              <iv:ImageInputView DataContext="{Binding EditImage}" />
            </Panel>
            <Grid ColumnDefinitions="*,12,*" IsVisible="{Binding SupportsSeveralEditImages}">
              <iv:ImageInputView DataContext="{Binding EditImage2}" />
              <Panel Grid.Column="2">
                <iv:ImageInputView DataContext="{Binding EditImage3}" />
              </Panel>
            </Grid>
            <Grid ColumnDefinitions="*,12,*" IsVisible="{Binding ShowImageToImage}">
              <iv:ImageInputView DataContext="{Binding Source}" />
              <Panel Grid.Column="2" IsVisible="{Binding UsesInputImage}">
                <iv:ImageInputView DataContext="{Binding Mask}" />
              </Panel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="accent" Content="Generate" Command="{Binding RunCommand}" />
              <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsGenerating}" />
              <TextBlock Classes="caption" Text="{Binding RunHint}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>
        <!-- Result -->
        <Border Grid.Row="1" Classes="card" ClipToBounds="True">
          <Grid RowDefinitions="Auto,*,Auto,Auto">
            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,10">
              <TextBlock Classes="h2" Text="Result" VerticalAlignment="Center" />
              <WrapPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" Margin="10,0,0,0" IsVisible="{Binding HasResult}">
                <ToggleButton Classes="small" Content="Compare with input" IsChecked="{Binding CompareWithInput}" IsVisible="{Binding UsesInputImage}"
                              ToolTip.Tip="Drag the divider to compare the input image (left) with the result (right)" />
                <Button Classes="small" Content="Save PNG" Command="{Binding SaveImageCommand}" ToolTip.Tip="Save the image; its prompt and parameters are in the file" />
                <Button Classes="small" Content="Use as input" Command="{Binding UseAsInputCommand}" ToolTip.Tip="Start the next run from this image" />
                <Button Classes="small" Content="Reuse seed" Command="{Binding ReuseSeedCommand}" ToolTip.Tip="Run again from the same noise" />
                <Button Classes="small" Content="Reuse prompt" Command="{Binding ReusePromptCommand}" />
              </WrapPanel>
            </Grid>
            <!-- The stage keeps a minimum height of its own row: the page scrolls instead of laying it out over the controls around it. -->
            <Panel Grid.Row="1" MinHeight="420" ClipToBounds="True">
              <StackPanel IsVisible="{Binding ShowPlaceholder}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <Path Classes="icon huge" Data="{StaticResource IconImage}" HorizontalAlignment="Center" />
                <TextBlock Classes="muted" Text="The picture appears here, taking shape step by step." HorizontalAlignment="Center" />
              </StackPanel>
              <vw:ImageViewer IsVisible="{Binding ShowPreview}" Source="{Binding PreviewPng, Converter={x:Static conv:BytesToBitmapConverter.Instance}}" />
              <vw:ImageViewer IsVisible="{Binding !ShowPreview}" Source="{Binding SelectedPng, Converter={x:Static conv:BytesToBitmapConverter.Instance}}"
                              CompareSource="{Binding ComparePng, Converter={x:Static conv:BytesToBitmapConverter.Instance}}" />
            </Panel>
            <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding HasSeveral}">
                <ListBox ItemsSource="{Binding Images}" SelectedItem="{Binding SelectedImage}">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="im:GeneratedImageViewModel">
                      <Border Width="72" Height="72" CornerRadius="4" ClipToBounds="True" ToolTip.Tip="{Binding Caption}">
                        <Image Source="{Binding Png, Converter={x:Static conv:BytesToBitmapConverter.Instance}, ConverterParameter=144}" Stretch="UniformToFill" />
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </ScrollViewer>
              <TextBlock Classes="caption" Text="{Binding StepText}" IsVisible="{Binding IsGenerating}" />
              <TextBlock Classes="caption" Text="{Binding ResultSummary}" TextWrapping="Wrap" IsVisible="{Binding HasResult}" />
            </StackPanel>
            <!-- Gallery of every stored image -->
            <vw:GalleryStripView Grid.Row="3" Margin="0,8,0,0" DataContext="{Binding Generations}" />
          </Grid>
        </Border>
      </Grid>
      </ScrollViewer>
    </iv:InferenceFrame.Workspace>
  </iv:InferenceFrame>
</UserControl>
