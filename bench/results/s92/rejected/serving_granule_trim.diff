     /// <summary>
+    /// Prompt rows a step may leave for the next one so that its rows end on a whole <see cref="BatchTokensGranule"/>: when every waiting
+    /// prompt row fits the step (it is not cut by the budget) and the step's rows are at most this many past a multiple of the granule
+    /// (and at least one granule), that many rows of the last prompt chunk move to the next step. A prompt-sized GEMM's time follows its
+    /// count of token tiles, so 15 decode rows and a 250-row prompt (265 rows, three 128-row tiles) cost 28.3 ms on Qwen3-8B-FP8 and 15
+    /// + 241 rows 22.2 ms, while the 9 rows cost 0.2 ms in the next decode step (benchmarks.md §91). Closed-loop streams that finish in
+    /// waves rarely meet such steps; with Poisson arrivals they are common (Qwen3-8B-FP8 at 7 requests per second and 16 slots: inter-token
+    /// p95 29 → 22 ms, §92). 0 turns it off.
+    /// </summary>
+    public int GranuleTrimRows { get; set; } = 32;
