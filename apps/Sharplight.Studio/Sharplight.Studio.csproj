<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>sharplight-studio</AssemblyName>
    <RootNamespace>Sharplight.Studio</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- API documentation (*.xml next to the assemblies) is for NuGet package consumers, not for the installed app: the 28 files of the
         referenced libraries and packages were 322 MB unpacked. Library projects still generate them for their packages. -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets/Icons/sharplight-studio.ico</ApplicationIcon>
    <Description>Sharplight Studio: desktop app to find, download, convert, run, chat with and serve local models.</Description>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Update feed baked into the build (CI passes the repository variable STUDIO_UPDATE_URL); empty disables update checks unless
         SHARPLIGHT_STUDIO_UPDATE_URL or the UpdateUrl setting provides one. See docs/studio.md, "Installing and updating". -->
    <StudioUpdateUrl Condition="'$(StudioUpdateUrl)' == ''">$(STUDIO_UPDATE_URL)</StudioUpdateUrl>
  </PropertyGroup>
  <ItemGroup Condition="'$(StudioUpdateUrl)' != ''">
    <AssemblyMetadata Include="StudioUpdateUrl" Value="$(StudioUpdateUrl)" />
  </ItemGroup>
  <PropertyGroup>
    <!-- The CUDA execution provider (Sharplight.Cuda with the NVRTC redistributables of Sharplight.Cuda.Runtime, ~115 MB installed, ~34 MB
         in the AppImage) ships for linux-x64, linux-arm64 and win-x64 only: NVIDIA has no driver for macOS or Windows on ARM. A build or
         publish for another runtime identifier (or without one, on macOS / Windows ARM) leaves it out; -p:StudioCuda=false leaves it out
         everywhere. See docs/studio.md, "Installing and updating", and docs/cuda.md. -->
    <StudioCuda Condition="'$(StudioCuda)' == '' And ('$(RuntimeIdentifier)' == 'linux-x64' Or '$(RuntimeIdentifier)' == 'linux-arm64' Or '$(RuntimeIdentifier)' == 'win-x64')">true</StudioCuda>
    <StudioCuda Condition="'$(StudioCuda)' == '' And '$(RuntimeIdentifier)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'X64' And !$([MSBuild]::IsOSPlatform('OSX'))">true</StudioCuda>
    <StudioCuda Condition="'$(StudioCuda)' == '' And '$(RuntimeIdentifier)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64' And $([MSBuild]::IsOSPlatform('Linux'))">true</StudioCuda>
    <StudioCuda Condition="'$(StudioCuda)' == ''">false</StudioCuda>
    <DefineConstants Condition="'$(StudioCuda)' == 'true'">$(DefineConstants);STUDIO_CUDA</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(StudioCuda)' == 'true'">
    <ProjectReference Include="../../src/Sharplight.Cuda/Sharplight.Cuda.csproj" />
    <!-- NVRTC and the floating-point headers: native files next to the executable (and in the package), no assembly. -->
    <ProjectReference Include="../../src/Sharplight.Cuda.Runtime/Sharplight.Cuda.Runtime.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Sharplight.Core/Sharplight.Core.csproj" />
    <!-- The OpenAI / Anthropic endpoints run in-process on Kestrel. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Sharplight/Sharplight.csproj" />
    <ProjectReference Include="../../src/Sharplight.Hub/Sharplight.Hub.csproj" />
    <ProjectReference Include="../../src/Sharplight.ModelFeed/Sharplight.ModelFeed.csproj" />
    <ProjectReference Include="../../src/Sharplight.AspNetCore/Sharplight.AspNetCore.csproj" />
    <ProjectReference Include="../../src/Sharplight.Hosting/Sharplight.Hosting.csproj" />
    <ProjectReference Include="../../src/Sharplight.Extensions.AI/Sharplight.Extensions.AI.csproj" />
    <!-- Composition root: the providers and importers the app registers at startup. -->
    <ProjectReference Include="../../src/Sharplight.Vulkan/Sharplight.Vulkan.csproj" />
    <ProjectReference Include="../../src/Sharplight.Cpu/Sharplight.Cpu.csproj" />
    <ProjectReference Include="../../src/Sharplight.Import.Gguf/Sharplight.Import.Gguf.csproj" />
    <ProjectReference Include="../../src/Sharplight.Import.HuggingFace/Sharplight.Import.HuggingFace.csproj" />
    <ProjectReference Include="../../src/Sharplight.Import.Onnx/Sharplight.Import.Onnx.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Window, taskbar and sidebar icon, rendered from packaging/linux/sharplight-studio.svg by packaging/make-studio-icons.py -->
    <AvaloniaResource Include="Assets/Icons/*.png" />
  </ItemGroup>
  <ItemGroup>
    <!-- The verified-model catalog (docs/verified-catalog.md): Discover's "Verified" list works offline with this copy. -->
    <EmbeddedResource Include="../../tools/model-feed/keys/sharplight-feed.pub.pem" LogicalName="Sharplight.Studio.sharplight-feed.pub.pem" Link="Assets/sharplight-feed.pub.pem" />
    <EmbeddedResource Include="../../catalog/verified-models.json" LogicalName="Sharplight.Studio.verified-models.json" Link="Assets/verified-models.json" />
    <EmbeddedResource Include="Assets/starter-models.json" LogicalName="Sharplight.Studio.starter-models.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Sharplight.Studio.Tests" />
  </ItemGroup>
</Project>
