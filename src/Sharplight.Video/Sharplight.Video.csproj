<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Video encoding and decoding for Sharplight through its own FFmpeg build (LGPL, shared libraries; native/ffmpeg/build.sh) bound with
    FFmpeg.AutoGen. The binaries are not committed: CI builds them (native.yml) into native/ffmpeg/out/<rid>/, and this project packs them as
    runtimes/<rid>/native/ and copies the ones of the build machine (or of the RuntimeIdentifier) next to the application.
    SharplightFfmpegDirectory overrides the directory. Set SharplightRequireFfmpeg=true (CI packaging does) to fail the build when the
    libraries of a target platform are missing instead of shipping a package that cannot encode.
  -->
  <PropertyGroup>
    <Description>Video encoding and decoding for Sharplight with bundled LGPL FFmpeg libraries (H.264 via OpenH264, AV1 via SVT-AV1 and dav1d, VP8/VP9 via libvpx, ProRes, FFV1, GIF, APNG; AAC/Opus audio; NVENC, VideoToolbox and Media Foundation where available) on win-x64, win-arm64, linux-x64, linux-arm64 and osx-arm64.</Description>
    <PackageTags>$(PackageTags);video;ffmpeg;mp4;webm;h264;av1;vp9;prores</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SharplightFfmpegDirectory Condition="'$(SharplightFfmpegDirectory)' == ''">$(MSBuildThisFileDirectory)../../native/ffmpeg/out/</SharplightFfmpegDirectory>
    <SharplightFfmpegLicenses>$(MSBuildThisFileDirectory)../../native/ffmpeg/licenses/</SharplightFfmpegLicenses>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen" />
    <ProjectReference Include="../Sharplight.Core/Sharplight.Core.csproj" />
    <InternalsVisibleTo Include="Sharplight.Video.Tests" />
  </ItemGroup>
  <ItemGroup>
    <SharplightFfmpegRid Include="linux-x64;linux-arm64;win-x64;win-arm64;osx-arm64" />
  </ItemGroup>
  <ItemGroup>
    <SharplightFfmpegLibrary Include="$(SharplightFfmpegDirectory)linux-x64/lib*.so.*" Rid="linux-x64" Condition="'$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'linux-x64'" />
    <SharplightFfmpegLibrary Include="$(SharplightFfmpegDirectory)linux-arm64/lib*.so.*" Rid="linux-arm64" Condition="'$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'linux-arm64'" />
    <SharplightFfmpegLibrary Include="$(SharplightFfmpegDirectory)win-x64/*.dll" Rid="win-x64" Condition="'$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'win-x64'" />
    <SharplightFfmpegLibrary Include="$(SharplightFfmpegDirectory)win-arm64/*.dll" Rid="win-arm64" Condition="'$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'win-arm64'" />
    <SharplightFfmpegLibrary Include="$(SharplightFfmpegDirectory)osx-arm64/*.dylib" Rid="osx-arm64" Condition="'$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'osx-arm64'" />
    <None Include="@(SharplightFfmpegLibrary)" Link="runtimes/%(Rid)/native/%(Filename)%(Extension)" Pack="true" PackagePath="runtimes/%(Rid)/native/" Visible="false"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(SharplightFfmpegLicenses)*" Link="licenses/ffmpeg/%(Filename)%(Extension)" Pack="true" PackagePath="licenses/ffmpeg/"
          Visible="false" CopyToOutputDirectory="PreserveNewest" />
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" CopyToOutputDirectory="PreserveNewest" Link="licenses/ffmpeg/THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

  <!-- The libraries every platform must have (the names the loader opens, BundledFfmpeg.LibraryFileNames). -->
  <Target Name="SharplightCheckFfmpeg" BeforeTargets="Build;Pack" Condition="'$(SharplightRequireFfmpeg)' == 'true'">
    <ItemGroup>
      <_SharplightFfmpegChecked Include="@(SharplightFfmpegRid)" Condition="'$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == '%(Identity)'" />
      <_SharplightFfmpegMissing Include="@(_SharplightFfmpegChecked)" Condition="!Exists('$(SharplightFfmpegDirectory)%(Identity)/ffmpeg-configuration.txt')" />
    </ItemGroup>
    <Error Condition="'@(_SharplightFfmpegMissing)' != ''" Text="The bundled FFmpeg libraries are missing for @(_SharplightFfmpegMissing) in $(SharplightFfmpegDirectory) (build them with native/ffmpeg/build.sh or download the native-ffmpeg-* CI artifacts)." />
  </Target>
</Project>
