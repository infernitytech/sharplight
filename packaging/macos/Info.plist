<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Info.plist of Sharplight Studio.app; build-app.sh fills in @VERSION@ and @SHORT_VERSION@. -->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Sharplight Studio</string>
    <key>CFBundleDisplayName</key>
    <string>Sharplight Studio</string>
    <key>CFBundleIdentifier</key>
    <string>io.github.infernitytech.sharplight.studio</string>
    <key>CFBundleExecutable</key>
    <string>sharplight-studio</string>
    <key>CFBundleIconFile</key>
    <string>sharplight-studio</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleShortVersionString</key>
    <string>@SHORT_VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@VERSION@</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSArchitecturePriority</key>
    <array>
        <string>arm64</string>
    </array>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright (c) Sharplight contributors. MIT License; MoltenVK: Apache License 2.0.</string>
</dict>
</plist>
