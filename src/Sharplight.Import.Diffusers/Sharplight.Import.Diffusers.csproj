<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Importer for latent-diffusion image models (Stable Diffusion 1.x / 2.x / SDXL): diffusers folders, single-file safetensors checkpoints and stable-diffusion.cpp GGUF files, translated into the canonical model source.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Sharplight.Core/Sharplight.Core.csproj" />
    <ProjectReference Include="../Sharplight.Gguf/Sharplight.Gguf.csproj" />
    <ProjectReference Include="../Sharplight.HuggingFace/Sharplight.HuggingFace.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources/clip-merges.txt.gz" LogicalName="Sharplight.Import.Diffusers.clip-merges.txt.gz" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Sharplight.ImageGeneration.Tests" />
  </ItemGroup>
</Project>
