                      "size": {
                        "type": "integer"
                      },
                      "sha256": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "gitOid": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "pattern": "^[0-9a-f]{40}$"
                      }
