<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvm="using:Sharplight.Studio.ViewModels.Models"
             xmlns:models="using:Sharplight.Studio.Models"
             xmlns:views="using:Sharplight.Studio.Views"
             x:Class="Sharplight.Studio.Views.LoadOptionsView"
             x:DataType="mvm:LoadOptionsViewModel">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Classes="ghost icon" Command="{Binding CloseCommand}" ToolTip.Tip="Close (cancels a load in progress)">
        <Path Classes="icon" Data="{StaticResource IconClose}" />
      </Button>
      <StackPanel>
        <TextBlock Classes="h2" Text="Load model" />
        <TextBlock Classes="caption" Text="{Binding Entry.Name}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
      <!-- Memory estimate of the current choices -->
      <Border x:Name="FitCard" DataContext="{Binding Fit}" x:DataType="mvm:FitEstimateViewModel" Classes="callout" Classes.ok="{Binding IsGood}"
              Classes.warn="{Binding IsWarning}" Classes.bad="{Binding IsBad}" IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
        <ScrollViewer MaxHeight="340" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="8" Margin="0,0,6,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding TotalText}" FontWeight="SemiBold" VerticalAlignment="Center"
                         ToolTip.Tip="Estimated from the model's graph for these settings" />
              <Panel DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                <Path Classes="icon ok" Data="{StaticResource IconCheck}" Width="14" Height="14" IsVisible="{Binding IsGood}" />
                <Path Classes="icon warn" Data="{StaticResource IconWarning}" Width="14" Height="14" IsVisible="{Binding IsWarning}" />
                <Path Classes="icon bad" Data="{StaticResource IconWarning}" Width="14" Height="14" IsVisible="{Binding IsBad}" />
              </Panel>
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                         ToolTip.Tip="{Binding Title}" />
            </DockPanel>
            <TextBlock Text="{Binding Message}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Devices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="mvm:DeviceFitViewModel">
                  <StackPanel Spacing="3" Margin="0,2">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Classes="caption" Text="{Binding NeedText}" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Classes="icon" Data="{StaticResource IconChip}" Width="12" Height="12" IsVisible="{Binding Fit.Device.IsGpu}" />
                        <Path Classes="icon" Data="{StaticResource IconMemory}" Width="12" Height="12" IsVisible="{Binding !Fit.Device.IsGpu}" />
                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DockPanel>
                    <Panel Height="8">
                      <Border CornerRadius="4" Background="{DynamicResource SurfaceHoverBrush}" />
                      <ProgressBar Classes="meter need" Classes.over="{Binding IsOver}" Classes.offload="{Binding IsOffload}" Minimum="0" Maximum="1" Value="{Binding NeedFraction}" />
                      <ProgressBar Classes="meter used" Minimum="0" Maximum="1" Value="{Binding UsedFraction}" />
                    </Panel>
                    <TextBlock Classes="caption" Text="{Binding MemoryText}" TextWrapping="Wrap" FontSize="11" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="caption" Text="{Binding Breakdown}" TextWrapping="Wrap" FontSize="11" />
            <StackPanel x:Name="FitSizing" Spacing="4" IsVisible="{Binding HasSizing}">
              <TextBlock Classes="section" Text="CONTEXT AND KV CACHE" />
              <ItemsControl ItemsSource="{Binding Sizing}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="mvm:FitSuggestionViewModel">
                    <Button Classes="ghost small" Command="{Binding ApplyCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="6,4"
                            ToolTip.Tip="Use these settings">
                      <DockPanel>
                        <Border DockPanel.Dock="Right" Classes="badge" Classes.ok="{Binding Fits}" Classes.warn="{Binding !Fits}" Margin="6,0,0,0">
                          <TextBlock Text="{Binding VerdictText}" />
                        </Border>
                        <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                      </DockPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <TextBlock x:Name="FitContextSummary" Classes="caption" Text="{Binding ContextSummary}" TextWrapping="Wrap" FontSize="11"
                       IsVisible="{Binding HasContextSummary}" />
            <StackPanel Spacing="4" IsVisible="{Binding HasSuggestions}">
              <TextBlock Classes="section" Text="TO MAKE IT FIT" />
              <ItemsControl ItemsSource="{Binding Suggestions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="mvm:FitSuggestionViewModel">
                    <Button Classes="ghost small" Command="{Binding ApplyCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="6,4"
                            ToolTip.Tip="Apply this change">
                      <DockPanel>
                        <Border DockPanel.Dock="Right" Classes="badge" Classes.ok="{Binding Fits}" Classes.warn="{Binding !Fits}" Margin="6,0,0,0">
                          <TextBlock Text="{Binding VerdictText}" />
                        </Border>
                        <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                      </DockPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsEstimating}">
        <ProgressBar Classes="thin" IsIndeterminate="True" Width="60" VerticalAlignment="Center" />
        <TextBlock Classes="caption" Text="Estimating memory…" />
      </StackPanel>
      <TextBlock Classes="caption" Text="{Binding FitError}" TextWrapping="Wrap" IsVisible="{Binding FitError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <StackPanel Spacing="4" IsVisible="{Binding IsLoading}">
        <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" />
      </StackPanel>
      <TextBlock Classes="caption" Text="{Binding Status}" TextWrapping="Wrap" />
      <Grid ColumnDefinitions="*,8,*">
        <Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Cancel" Command="{Binding CloseCommand}" />
        <Button Grid.Column="2" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Load" Command="{Binding LoadCommand}" />
      </Grid>
    </StackPanel>
    <ScrollViewer>
      <StackPanel Spacing="12" Margin="0,0,8,0">
        <StackPanel>
          <TextBlock Classes="label" Text="Name (the model field API clients send)" />
          <TextBox Text="{Binding ModelId}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="label" Text="Device" />
          <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="models:ComputeDeviceOption">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Classes="icon" Data="{StaticResource IconChip}" Width="13" Height="13" />
                  <TextBlock Text="{Binding Display}" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Spacing="12" IsVisible="{Binding IsLanguageModel}">
          <StackPanel>
            <TextBlock Classes="label" Text="Context length (tokens per sequence)" />
            <NumericUpDown Value="{Binding ContextLength}" Minimum="256" Maximum="1048576" Increment="1024" FormatString="0" />
            <TextBlock Classes="caption" Text="{Binding ContextHint}" Margin="0,3,0,0" />
          </StackPanel>
          <Grid ColumnDefinitions="*,10,*">
            <StackPanel>
              <TextBlock Classes="label" Text="Parallel slots" />
              <NumericUpDown Value="{Binding Slots}" Minimum="1" Maximum="64" Increment="1" FormatString="0" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Classes="label" Text="Batch (prompt chunk)" />
              <NumericUpDown Value="{Binding BatchTokens}" Minimum="16" Maximum="8192" Increment="128" FormatString="0" />
            </StackPanel>
          </Grid>
          <StackPanel>
            <TextBlock Classes="label" Text="KV cache" />
            <ComboBox ItemsSource="{Binding KvCacheChoices}" SelectedItem="{Binding KvCache}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="mvm:KvCacheChoice">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <Grid ColumnDefinitions="*,10,*">
            <StackPanel>
              <TextBlock Classes="label" Text="Lookup draft tokens" />
              <NumericUpDown Value="{Binding NgramDraftTokens}" Minimum="0" Maximum="16" Increment="1" FormatString="0" ToolTip.Tip="Drafts tokens by finding them in the conversation, faster for edits and quotes; 0 = off" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Classes="label" Text="Draft head tokens" />
              <NumericUpDown Value="{Binding MtpDraftTokens}" Minimum="0" Maximum="8" Increment="1" FormatString="0" ToolTip.Tip="Drafts several tokens at once with the model's own prediction head (models that have one); 0 = off" />
            </StackPanel>
          </Grid>
          <ToggleSwitch Content="Offload to the CPU when it does not fit" IsChecked="{Binding CpuOffload}" IsEnabled="{Binding CanOffload}" />
          <ToggleSwitch Content="Read experts from disk when they do not fit memory (slow)" IsChecked="{Binding ExpertsOnDisk}" IsEnabled="{Binding CpuOffload}"
                        ToolTip.Tip="Mixture-of-experts models larger than system memory and GPU memory together: their routed experts stay in the model file and are read on demand from a fast SSD (about 1 token/s on huge models)" />
        </StackPanel>
        <StackPanel Spacing="4" IsVisible="{Binding NeedsCompanions}">
          <ItemsControl ItemsSource="{Binding Companions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="mvm:CompanionFileViewModel">
                <StackPanel Spacing="4" Margin="0,0,0,4">
                  <TextBlock Classes="label" Text="{Binding Label}" />
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="small" Content="Browse" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
                    <TextBox Text="{Binding Path}" PlaceholderText="{Binding Example}" />
                  </DockPanel>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="This file holds only the diffusion transformer; the text encoders and the VAE come as separate files (those found next to it are filled in). A .slm package made with them needs none." />
        </StackPanel>
        <StackPanel Spacing="4" IsVisible="{Binding SupportsLoras}">
          <TextBlock Classes="label" Text="LoRAs" />
          <views:LoraListView DataContext="{Binding Loras}" />
        </StackPanel>
        <StackPanel Spacing="4" IsVisible="{Binding NeedsVocoder}">
          <TextBlock Classes="label" Text="Vocoder (codec decoder file)" />
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="small" Content="Browse" Command="{Binding BrowseVocoderCommand}" Margin="8,0,0,0" />
            <TextBox Text="{Binding VocoderPath}" PlaceholderText="WavTokenizer .gguf or SNAC folder" />
          </DockPanel>
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="This speech model is a language model that writes audio codes; the vocoder turns them into sound. A .slm package made with the vocoder needs none." />
        </StackPanel>
        <StackPanel Spacing="2">
          <ToggleSwitch Content="Reduced precision (opt-in)" IsChecked="{Binding AllowReducedPrecision}" />
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="Faster, lower-precision math in some models. Answers may differ slightly." />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
