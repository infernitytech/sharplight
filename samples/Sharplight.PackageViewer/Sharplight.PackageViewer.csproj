<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>sharplight-viewer</AssemblyName>
    <RootNamespace>Sharplight.PackageViewer</RootNamespace>
    <IsPackable>false</IsPackable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Sharplight.Package/Sharplight.Package.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Sharplight.PackageViewer.Tests" />
  </ItemGroup>
</Project>
