+[shader("compute")]
+[numthreads(256, 1, 1)]
+void gemm_fp8_nv2(uint3 gid : SV_GroupID, uint3 ltid : SV_GroupThreadID, uniform Params p)
+{
+    uint tid = ltid.x;
+    uint t0 = gid.x * NV_BT, n0 = gid.y * NV_BN;
+    var lx = TensorLayout<2, CoopMatClampMode.Constant>().Dimension(p.T, K).Stride(F8ROW, 1);
+    var lw = TensorLayout<2, CoopMatClampMode.Constant>().Dimension(N, K).Stride(uint(ROW_BYTES), 1);
+    var wT = TensorView<2, false, 1, 0>();
+    Nv8C acc = Nv8C(0.0);
+    uint steps = K / NV8_BK;
+    // Scales of step s in buffer s % 3.
+    #define NV8_SCALES(s, b)                                                                                           \
+    if (tid < NV_BT) nvXs[b][tid] = *(float*)byteAt(p.x, uint64_t(min(t0 + tid, p.T - 1)) * F8ROW + K + (s) * 4);      \
+    else if (tid - NV_BT < NV_BN) nvWs[b][tid - NV_BT] = *(float*)(rowStart(p.w, ROW_BYTES, min(n0 + tid - NV_BT, uint(N) - 1)) + uint64_t(K) + (s) * 4);
+    NV8_SCALES(0, 0)
+    for (uint s = 0; s < steps; s++)
+    {
+        uint k0 = s * NV8_BK;
+        Nv8A a = Nv8A.Load((FloatE4M3*)p.x, Nv8A(0.0), lx.Slice(t0, NV_BT, k0, NV8_BK));
+        Nv8B b = Nv8B.Load((FloatE4M3*)p.w, Nv8B(0.0), lw.Slice(n0, NV_BN, k0, NV8_BK), wT);
+#ifdef NV8_NOSCALE
+        acc = coopMatMulAdd<float, false>(a, b, acc);
+        continue;
+#endif
+        Nv8C c = coopMatMulAdd<float, false>(a, b, Nv8C(0.0));
+#ifdef NV8_BCAST
+        // Scales as broadcast tensor loads (stride 0 along the other dimension).
+        var lxs = TensorLayout<2, CoopMatClampMode.Constant>().Dimension(p.T, N).Stride(F8ROW / 4, 0);
+        var lws = TensorLayout<2, CoopMatClampMode.Constant>().Dimension(p.T, N).Stride(0, uint(ROW_BYTES / 4));
+        Nv8C sx = Nv8C.Load((float*)p.x + K / 4 + s, Nv8C(0.0), lxs.Slice(t0, NV_BT, n0, NV_BN));
+        Nv8C sw = Nv8C.Load((float*)p.w + K / 4 + s, Nv8C(0.0), lws.Slice(t0, NV_BT, n0, NV_BN));
+        acc = acc + c * sx * sw;
+#else
+        if (s + 1 < steps)
+        {
+            NV8_SCALES(s + 1, (s + 1) % 3)
+        }
+        GroupMemoryBarrierWithGroupSync();
+        Nv8Scale f;
+        f.buf = s % 3;
+        acc = acc + c.MapElement(f);
+#endif
+    }
+    #undef NV8_SCALES
+    var ly = TensorLayout<2, CoopMatClampMode.Constant>().Dimension(p.T, N).Stride(Y_STRIDE, 1);
+    acc.Store(p.y, ly.Slice(t0, NV_BT, n0, NV_BN));
+}
+#endif
