<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- AddSharplight and SharplightDefaults live in the root namespace, visible from every Sharplight.* namespace without a using. -->
    <RootNamespace>Sharplight</RootNamespace>
    <Description>Sharplight with its defaults: references the core, the built-in architecture adapters, the GGUF, Hugging Face, ONNX, whisper.cpp, diffusers and .slm importers and the CPU, Metal and Vulkan execution providers, and wires them up with services.AddSharplight() (the task layer included).</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Sharplight.Core/Sharplight.Core.csproj" />
    <ProjectReference Include="../Sharplight.Import.Gguf/Sharplight.Import.Gguf.csproj" />
    <ProjectReference Include="../Sharplight.Import.HuggingFace/Sharplight.Import.HuggingFace.csproj" />
    <ProjectReference Include="../Sharplight.Import.Onnx/Sharplight.Import.Onnx.csproj" />
    <ProjectReference Include="../Sharplight.Import.Diffusers/Sharplight.Import.Diffusers.csproj" />
    <ProjectReference Include="../Sharplight.Import.WhisperCpp/Sharplight.Import.WhisperCpp.csproj" />
    <ProjectReference Include="../Sharplight.Import.Kokoro/Sharplight.Import.Kokoro.csproj" />
    <ProjectReference Include="../Sharplight.Import.Chatterbox/Sharplight.Import.Chatterbox.csproj" />
    <ProjectReference Include="../Sharplight.Import.F5Tts/Sharplight.Import.F5Tts.csproj" />
    <ProjectReference Include="../Sharplight.Import.Xtts/Sharplight.Import.Xtts.csproj" />
    <ProjectReference Include="../Sharplight.Import.CosyVoice/Sharplight.Import.CosyVoice.csproj" />
    <ProjectReference Include="../Sharplight.Import.Snac/Sharplight.Import.Snac.csproj" />
    <ProjectReference Include="../Sharplight.Import.SileroVad/Sharplight.Import.SileroVad.csproj" />
    <ProjectReference Include="../Sharplight.Import.Ultralytics/Sharplight.Import.Ultralytics.csproj" />
    <ProjectReference Include="../Sharplight.Cpu/Sharplight.Cpu.csproj" />
    <ProjectReference Include="../Sharplight.Metal/Sharplight.Metal.csproj" />
    <ProjectReference Include="../Sharplight.Vulkan/Sharplight.Vulkan.csproj" />
    <ProjectReference Include="../Sharplight.Audio/Sharplight.Audio.csproj" />
    <ProjectReference Include="../Sharplight.Video/Sharplight.Video.csproj" />
  </ItemGroup>
</Project>
