<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:au="using:Sharplight.Studio.ViewModels.Audio"
             xmlns:iv="using:Sharplight.Studio.Views.Inference"
             x:Class="Sharplight.Studio.Views.AudioPage"
             x:DataType="au:AudioPageViewModel">
  <iv:InferenceFrame>
    <iv:InferenceFrame.Workspace>
      <!-- Scrolls when the window is too small for the input and the result, instead of laying the result out over the controls around it. -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid RowDefinitions="Auto,*" RowSpacing="14">
        <!-- Input -->
        <Border x:Name="InputCard" Classes="card" DragDrop.AllowDrop="True">
          <StackPanel Spacing="12">
            <TextBlock Classes="h2" Text="Audio" />
            <TextBlock Classes="muted" Text="{Binding ModeDescription}" TextWrapping="Wrap" />
            <TextBox Text="{Binding Prompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="120" VerticalContentAlignment="Top" IsVisible="{Binding IsMusic}"
                     PlaceholderText="Describe the music or sound: genre, instruments, mood, an effect (for example: calm piano with soft strings)" />
            <TextBox Text="{Binding Lyrics}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxHeight="220" VerticalContentAlignment="Top" IsVisible="{Binding IsLyricMusic}"
                     PlaceholderText="Lyrics with section tags ([verse], [chorus]); leave empty for an instrumental" />
            <TextBox Text="{Binding NegativePrompt}" AcceptsReturn="False" TextWrapping="Wrap" MaxHeight="80" IsVisible="{Binding IsNegativePromptMusic}"
                     PlaceholderText="Negative prompt: what it should not sound like (for example: low quality, distortion); optional" />
            <DockPanel IsVisible="{Binding NeedsAudio}">
              <Button DockPanel.Dock="Right" Classes="small" Content="Choose file" Command="{Binding ChooseFileCommand}" Margin="12,0,0,0" />
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding AudioName2}" TextTrimming="CharacterEllipsis" FontWeight="Medium" IsVisible="{Binding HasAudio}" ToolTip.Tip="{Binding AudioPath}" />
                <TextBlock Classes="caption" Text="{Binding AudioSummary}" IsVisible="{Binding HasAudio}" />
                <TextBlock Classes="muted" Text="Drop an audio file here or choose one." IsVisible="{Binding !HasAudio}" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>
            <TextBox Text="{Binding Labels}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="140" VerticalContentAlignment="Top" IsVisible="{Binding IsTagging}"
                     PlaceholderText="One candidate text per line" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="accent" Content="{Binding RunText}" Command="{Binding RunCommand}" />
              <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" />
              <TextBlock Classes="caption" Text="{Binding RunHint}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>
        <!-- Result -->
        <Border Grid.Row="1" Classes="card" ClipToBounds="True">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="Result" />
            <TextBlock Classes="muted" Text="The result appears here once the run is done." IsVisible="{Binding !HasResult}" />
            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" IsVisible="{Binding HasReconstruction}">
              <Button Classes="accent small" Command="{Binding PlayCommand}" Content="{Binding PlayText}" />
              <Button Classes="small" Content="Save as WAV" Command="{Binding SaveCommand}" />
            </WrapPanel>
            <ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding IsTagging}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="au:TagScoreViewModel">
                  <StackPanel Spacing="2" Margin="0,2">
                    <TextBlock Text="{Binding Label}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Height="8" Width="{Binding BarWidth}" CornerRadius="4" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                      <TextBlock Classes="caption" Text="{Binding Text}" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding StemResults}" IsVisible="{Binding IsSeparation}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="au:StemViewModel">
                  <WrapPanel Orientation="Horizontal" ItemSpacing="8" Margin="0,3">
                    <TextBlock Text="{Binding Name}" Width="90" VerticalAlignment="Center" FontWeight="Medium" />
                    <Button Classes="small" Content="Play" Command="{Binding PlayCommand}" />
                    <Button Classes="small" Content="Save as WAV" Command="{Binding SaveCommand}" />
                  </WrapPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding IsVoiceActivity}">
            <ItemsControl ItemsSource="{Binding Segments}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="au:SpeechSegmentViewModel">
                  <StackPanel Spacing="2" Margin="0,2">
                    <Border Height="8" Width="560" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource SurfaceAltBrush}">
                      <Border Height="8" Width="{Binding BarWidth}" Margin="{Binding Offset}" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource AccentBrush}" />
                    </Border>
                    <TextBlock Classes="caption" Text="{Binding Text}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
            <TextBlock Classes="caption" Text="{Binding ResultSummary}" IsVisible="{Binding HasResult}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>
      </ScrollViewer>
    </iv:InferenceFrame.Workspace>
  </iv:InferenceFrame>
</UserControl>
