<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>F5-TTS importer for Sharplight: reads the F5-TTS flow-matching text-to-speech checkpoint (diffusion transformer, character vocabulary) and the Vocos mel vocoder into Sharplight speech-synthesis models.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Sharplight.Core/Sharplight.Core.csproj" />
    <ProjectReference Include="../Sharplight.Import.PyTorch/Sharplight.Import.PyTorch.csproj" />
    <ProjectReference Include="../Sharplight.Import.HuggingFace/Sharplight.Import.HuggingFace.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Sharplight.TextToSpeech.Tests" />
  </ItemGroup>
</Project>
