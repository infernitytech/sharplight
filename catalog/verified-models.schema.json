                "type": "boolean"
              },
              "memoryBytes": {
                "type": "integer"
              },
              "companions": {
                "$ref": "#/properties/entries/items/properties/variants/items/properties/companions"
              },
              "level": {
                "enum": [
                  "verified",
                  "partial",
                  "loads",
                  "verified-tiny",
                  null
                ]
              },
              "verification": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "quality": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "qualityNote": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "repository": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "tag": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "include": {
                "$ref": "#/properties/entries/items/properties/variants/items/properties/include"
              },
              "primary": {
                "type": "string"
              },
              "files": {
                "$ref": "#/properties/entries/items/properties/variants/items/properties/files"
              },
              "totalBytes": {
                "type": "integer"
              }
