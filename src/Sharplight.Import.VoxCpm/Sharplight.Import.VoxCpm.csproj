<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>VoxCPM importer for Sharplight: reads OpenBMB's VoxCPM2 text-to-speech checkpoint (MiniCPM-4 text-semantic and residual acoustic language models, local feature encoder and diffusion transformer, AudioVAE V2) into Sharplight speech-synthesis models.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Sharplight.Core/Sharplight.Core.csproj" />
    <ProjectReference Include="../Sharplight.Import.PyTorch/Sharplight.Import.PyTorch.csproj" />
    <ProjectReference Include="../Sharplight.Import.HuggingFace/Sharplight.Import.HuggingFace.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Sharplight.TextToSpeech.Tests" />
  </ItemGroup>
</Project>
