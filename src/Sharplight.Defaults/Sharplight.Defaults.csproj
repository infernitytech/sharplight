<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- SharplightDefaults lives in the root namespace, visible from every Sharplight.* namespace without a using. -->
    <RootNamespace>Sharplight</RootNamespace>
    <Description>Sharplight with its defaults: references the core, the built-in architecture adapters, the GGUF, Hugging Face, ONNX and .slm importers and the CPU and Vulkan execution providers, and wires them up with SharplightDefaults.Register().</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Sharplight.Core/Sharplight.Core.csproj" />
    <ProjectReference Include="../Sharplight.Architectures/Sharplight.Architectures.csproj" />
    <ProjectReference Include="../Sharplight.Import.Gguf/Sharplight.Import.Gguf.csproj" />
    <ProjectReference Include="../Sharplight.Import.HuggingFace/Sharplight.Import.HuggingFace.csproj" />
    <ProjectReference Include="../Sharplight.Import.Onnx/Sharplight.Import.Onnx.csproj" />
    <ProjectReference Include="../Sharplight.Package/Sharplight.Package.csproj" />
    <ProjectReference Include="../Sharplight.Cpu/Sharplight.Cpu.csproj" />
    <ProjectReference Include="../Sharplight.Vulkan/Sharplight.Vulkan.csproj" />
  </ItemGroup>
</Project>
