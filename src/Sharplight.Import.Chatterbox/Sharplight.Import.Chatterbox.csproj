<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Chatterbox importer for Sharplight: reads Resemble AI's Chatterbox text-to-speech checkpoint (T3 token language model, S3Gen flow-matching decoder and HiFT vocoder, voice encoder, built-in voice) into Sharplight speech-synthesis models.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Sharplight.Core/Sharplight.Core.csproj" />
    <ProjectReference Include="../Sharplight.Import.PyTorch/Sharplight.Import.PyTorch.csproj" />
    <ProjectReference Include="../Sharplight.Import.HuggingFace/Sharplight.Import.HuggingFace.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Sharplight.TextToSpeech.Tests" />
  </ItemGroup>
</Project>
