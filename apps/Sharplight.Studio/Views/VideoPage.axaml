<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sharplight.Studio.ViewModels.Video"
             xmlns:iv="using:Sharplight.Studio.Views.Inference"
             xmlns:conv="using:Sharplight.Studio.Converters"
             xmlns:vw="using:Sharplight.Studio.Views"
             xmlns:video="using:Sharplight.Video"
             x:Class="Sharplight.Studio.Views.VideoPage"
             x:DataType="vm:VideoPageViewModel">
  <iv:InferenceFrame>
    <iv:InferenceFrame.Workspace>
      <Grid RowDefinitions="Auto,*" RowSpacing="14">
        <!-- Input -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="Prompt" />
            <TextBox Text="{Binding Prompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="120" VerticalContentAlignment="Top"
                     PlaceholderText="Describe the video, for example: a red fox trotting through snow" />
            <TextBox Text="{Binding NegativePrompt}" TextWrapping="Wrap" PlaceholderText="Negative prompt: what the video should not show (optional)" />
            <StackPanel IsVisible="{Binding SupportsImage}" Spacing="6">
              <iv:ImageInputView DataContext="{Binding Source}" />
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding CanUseVideoFrames}">
                <Button Classes="small" Content="First frame of a video…" Command="{Binding PickStartFrameCommand}" CommandParameter="first"
                        ToolTip.Tip="Start from the first frame of a video file" />
                <Button Classes="small" Content="Last frame of a video…" Command="{Binding PickStartFrameCommand}" CommandParameter="last"
                        ToolTip.Tip="Continue a video: start from its last frame" />
              </StackPanel>
            </StackPanel>
            <Panel IsVisible="{Binding SupportsLastImage}">
              <iv:ImageInputView DataContext="{Binding LastSource}" />
            </Panel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="accent" Content="Generate" Command="{Binding RunCommand}" />
              <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsGenerating}" />
              <TextBlock Classes="caption" Text="{Binding RunHint}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>
        <!-- Result -->
        <Border Grid.Row="1" Classes="card">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasResult}">
                <Button Classes="small" Content="Reuse seed" Command="{Binding ReuseSeedCommand}" ToolTip.Tip="Run again from the same noise" />
                <Button Classes="small" Content="Reuse prompt" Command="{Binding ReusePromptCommand}" />
              </StackPanel>
              <TextBlock Classes="h2" Text="Result" VerticalAlignment="Center" />
            </DockPanel>
            <vw:GalleryStripView DockPanel.Dock="Bottom" Margin="0,8,0,0" DataContext="{Binding Generations}" />
            <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,8,0,0">
              <!-- Playback -->
              <Panel IsVisible="{Binding Player.CanPlay}">
              <Grid ColumnDefinitions="Auto,*,Auto" DataContext="{Binding Player}" x:DataType="vm:VideoPlayerViewModel">
                <Button Classes="small" Command="{Binding TogglePlayCommand}" ToolTip.Tip="{Binding PlayTip}" Width="34">
                  <Path Classes="icon" Data="{Binding PlayIcon, Converter={x:Static conv:IconConverter.Instance}}" />
                </Button>
                <Slider Grid.Column="1" Margin="10,0" Minimum="0" Maximum="{Binding LastPosition}" Value="{Binding Position}" SmallChange="1" LargeChange="4"
                        TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                <ToggleButton Grid.Column="2" Classes="small" Content="Loop" IsChecked="{Binding Loop}" ToolTip.Tip="Start again after the last frame" />
              </Grid>
              </Panel>
              <TextBlock Classes="caption" Text="{Binding Player.PositionText}" IsVisible="{Binding Player.HasFrames}" />
              <!-- Export: format, then the codec choices of its encoder -->
              <StackPanel Spacing="6" IsVisible="{Binding HasResult}">
                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                  <ComboBox ItemsSource="{Binding Export.Formats}" SelectedItem="{Binding Export.SelectedFormat}" MinWidth="110" ToolTip.Tip="File format">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:VideoExportFormatViewModel">
                        <TextBlock Text="{Binding Display}" ToolTip.Tip="{Binding Tip}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <ComboBox ItemsSource="{Binding Export.Codecs}" SelectedItem="{Binding Export.SelectedCodec}" IsVisible="{Binding Export.HasCodecs}" MinWidth="140" ToolTip.Tip="Video codec">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="video:VideoCodecInfo">
                        <TextBlock Text="{Binding DisplayName}" ToolTip.Tip="{Binding Description}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <ComboBox ItemsSource="{Binding Export.Presets}" SelectedItem="{Binding Export.SelectedPreset}" IsVisible="{Binding Export.HasPresets}" MinWidth="100"
                            ToolTip.Tip="Speed preset: faster encodes make larger files (for ProRes: the profile)" />
                  <ComboBox ItemsSource="{Binding Export.PixelFormats}" SelectedItem="{Binding Export.SelectedPixelFormat}" IsVisible="{Binding Export.HasPixelFormats}" MinWidth="110"
                            ToolTip.Tip="Pixel format (chroma subsampling and bit depth)" />
                  <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Export.ShowQuality}" VerticalAlignment="Center">
                    <TextBlock Classes="caption" Text="Quality" VerticalAlignment="Center" />
                    <Slider Minimum="0" Maximum="100" Value="{Binding Export.Quality}" Width="110" SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                            ToolTip.Tip="0 = smallest file, 100 = best quality" />
                    <TextBlock Classes="caption" Text="{Binding Export.Quality, StringFormat='{}{0:0}'}" VerticalAlignment="Center" MinWidth="22" />
                  </StackPanel>
                  <NumericUpDown Value="{Binding Export.BitrateKilobitsPerSecond}" Minimum="0" Maximum="200000" Increment="500" FormatString="0" Width="150"
                                 IsVisible="{Binding Export.ShowQuality}" ToolTip.Tip="Target bitrate in kbit/s; 0 encodes at constant quality" />
                  <Button Classes="small accent" Content="Export…" Command="{Binding ExportCommand}" VerticalAlignment="Center" />
                </WrapPanel>
                <TextBlock Classes="caption" Text="{Binding Export.CodecDescription}" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock Classes="caption" Text="{Binding StepText}" IsVisible="{Binding HasStepText}" />
              <TextBlock Classes="caption" Text="{Binding ResultSummary}" TextWrapping="Wrap" IsVisible="{Binding HasResult}" />
            </StackPanel>
            <Panel>
              <StackPanel IsVisible="{Binding ShowPlaceholder}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <Path Classes="icon huge" Data="{StaticResource IconVideo}" HorizontalAlignment="Center" />
                <TextBlock Classes="muted" Text="The video appears here, frame by frame." HorizontalAlignment="Center" />
              </StackPanel>
              <Border CornerRadius="8" ClipToBounds="True" IsVisible="{Binding Player.HasFrames}" MinHeight="320">
                <vw:ImageViewer Source="{Binding Player.CurrentFrame, Converter={x:Static conv:FrameToBitmapConverter.Instance}}" />
              </Border>
            </Panel>
          </DockPanel>
        </Border>
      </Grid>
    </iv:InferenceFrame.Workspace>
  </iv:InferenceFrame>
</UserControl>
