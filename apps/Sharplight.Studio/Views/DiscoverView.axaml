<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvm="using:Sharplight.Studio.ViewModels.Models"
             x:Class="Sharplight.Studio.Views.DiscoverView"
             x:DataType="mvm:HubSearchViewModel">
  <Grid ColumnDefinitions="*,16,420" RowDefinitions="Auto,*" Margin="0,0,0,16">
    <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Classes="accent" Command="{Binding SearchCommand}" Margin="8,0,0,0" Padding="16,7">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Classes="icon" Data="{StaticResource IconSearch}" />
          <TextBlock Text="Search" />
        </StackPanel>
      </Button>
      <CheckBox DockPanel.Dock="Right" Content="Hide gated" IsChecked="{Binding HideGated}" Margin="12,0,0,0" />
      <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" Margin="8,0,0,0" MinWidth="140">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="mvm:FormatFilter">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBox x:Name="QueryBox" Text="{Binding Query}" PlaceholderText="Search Hugging Face, e.g. qwen3 gguf, gemma, llama 8b instruct">
        <TextBox.InnerLeftContent>
          <Path Classes="icon" Data="{StaticResource IconSearch}" Width="14" Height="14" Margin="10,0,0,0" />
        </TextBox.InnerLeftContent>
      </TextBox>
    </DockPanel>

    <Border Grid.Row="1" Classes="card" Padding="6">
      <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="10,6">
          <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" Width="80" IsVisible="{Binding IsSearching}" VerticalAlignment="Center" />
          <TextBlock Classes="caption" Text="{Binding Status}" TextWrapping="Wrap" />
        </DockPanel>
        <ListBox Classes="plain" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="mvm:HubResultViewModel">
              <DockPanel Margin="12,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Path Classes="icon" Data="{StaticResource IconDownload}" Width="13" Height="13" />
                    <TextBlock Classes="caption" Text="{Binding Downloads}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Path Classes="icon" Data="{StaticResource IconHeart}" Width="13" Height="13" />
                    <TextBlock Classes="caption" Text="{Binding Likes}" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Spacing="3">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="caption" Text="{Binding Owner, StringFormat='{}{0} /'}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Classes="badge danger" IsVisible="{Binding Gated}" ToolTip.Tip="Gated: accept the license on Hugging Face and set a token in the settings">
                      <TextBlock Text="Gated" />
                    </Border>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Classes="badge accent">
                      <TextBlock Text="{Binding Formats}" />
                    </Border>
                    <Border Classes="badge" IsVisible="{Binding Parameters, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <TextBlock Text="{Binding Parameters}" />
                    </Border>
                    <TextBlock Classes="caption" Text="{Binding Variants}" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Details -->
    <Border Grid.Row="1" Grid.Column="2" Classes="card">
      <Panel>
        <StackPanel IsVisible="{Binding !HasSelection}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
          <Path Classes="icon huge" Data="{StaticResource IconModels}" HorizontalAlignment="Center" />
          <TextBlock Classes="muted" Text="Select a model to see its quantizations." HorizontalAlignment="Center" />
        </StackPanel>
        <DockPanel IsVisible="{Binding HasSelection}">
          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
            <TextBlock Classes="h2" Text="{Binding SelectedId}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="caption" Text="{Binding DetailFormat}" />
              <Button Classes="ghost small" Command="{Binding OpenOnHubCommand}" Padding="4,1">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="Open on Hugging Face" FontSize="12" />
                  <Path Classes="icon" Data="{StaticResource IconExternal}" Width="11" Height="11" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
          <Button DockPanel.Dock="Bottom" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding DownloadCommand}" Margin="0,12,0,0" Padding="0,9">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Classes="icon" Data="{StaticResource IconDownload}" />
              <TextBlock Text="Download, convert and add to the library" />
            </StackPanel>
          </Button>
          <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsLoadingDetails}" Margin="0,0,0,8" />
          <TextBlock DockPanel.Dock="Top" Classes="section" Text="QUANTIZATIONS" Margin="0,0,0,6" />
          <ListBox Classes="plain" ItemsSource="{Binding Variants}" SelectedItem="{Binding SelectedVariant}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="mvm:VariantViewModel">
                <DockPanel Margin="10,8">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" FontWeight="Medium" VerticalAlignment="Center" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Tag}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Classes="badge accent" IsVisible="{Binding Recommended}">
                      <TextBlock Text="Recommended" />
                    </Border>
                    <Border Classes="badge vision" IsVisible="{Binding HasProjector}" ToolTip.Tip="Comes with a vision projector (mmproj)">
                      <TextBlock Text="Vision" />
                    </Border>
                    <Border Classes="badge tools" IsVisible="{Binding IsStored}">
                      <TextBlock Text="In library" />
                    </Border>
                    <TextBlock Classes="caption" Text="{Binding Files}" VerticalAlignment="Center" />
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Panel>
    </Border>
  </Grid>
</UserControl>
