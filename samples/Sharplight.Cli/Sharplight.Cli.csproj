<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>sharplight</AssemblyName>
    <!-- The command stays "sharplight"; the package id differs so it does not clash with the Sharplight library package in restore. -->
    <PackageId>Sharplight.Cli</PackageId>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <!-- Image file decoding lives in samples only; the libraries take raw RGB pixels. -->
    <PackageReference Include="StbImageSharp" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Sharplight.Samples.Common/Sharplight.Samples.Common.csproj" />
    <ProjectReference Include="../Sharplight.Samples.Hub/Sharplight.Samples.Hub.csproj" />
    <ProjectReference Include="../../src/Sharplight.Core/Sharplight.Core.csproj" />
    <ProjectReference Include="../../src/Sharplight.Vulkan/Sharplight.Vulkan.csproj" />
    <ProjectReference Include="../../src/Sharplight.Cpu/Sharplight.Cpu.csproj" />
  </ItemGroup>
</Project>
