<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ga="using:Sharplight.Studio.ViewModels.Gallery"
             x:Class="Sharplight.Studio.Views.GalleryStripView"
             x:DataType="ga:ImageGalleryViewModel">
  <!-- The gallery of the generated pictures or videos of a page: filters, a strip of thumbnails and the actions on the chosen one. -->
  <Expander Header="{Binding CountText, StringFormat='Gallery: {0}'}" IsExpanded="True" HorizontalAlignment="Stretch">
    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
        <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Models}" SelectedItem="{Binding ModelFilter}" MinWidth="150" Margin="6,0,0,0" />
        <TextBox Text="{Binding TextFilter}" PlaceholderText="Filter by prompt" />
      </DockPanel>
      <WrapPanel DockPanel.Dock="Bottom" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" Margin="0,6,0,0" IsVisible="{Binding HasSelection}">
        <Button Classes="small" Content="Reuse settings" Command="{Binding ReuseSettingsCommand}" ToolTip.Tip="Fill the prompts, seed, size, steps and the other parameters from this image" />
        <Button Classes="small" Content="Copy prompt" Command="{Binding CopyPromptCommand}" />
        <Button Classes="small" Content="Open folder" Command="{Binding OpenFolderCommand}" />
        <Button Classes="small" Content="Save as…" Command="{Binding ExportCommand}" />
        <Button Classes="small danger" Content="{Binding DeleteText}" Command="{Binding DeleteCommand}" />
        <Button Classes="small" Content="Keep" Command="{Binding CancelDeleteCommand}" IsVisible="{Binding IsConfirmingDelete}" />
      </WrapPanel>
      <TextBlock Classes="muted" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" />
      <ListBox ItemsSource="{Binding Visible}" SelectedItem="{Binding SelectedItem}" Height="104" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="ga:GalleryItemViewModel">
            <Border Width="84" Height="84" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource BorderSubtleBrush}" ToolTip.Tip="{Binding Caption}">
              <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Expander>
</UserControl>
