<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Native-only package: the NVIDIA CUDA redistributables the CUDA provider (Sharplight.Cuda) needs on a machine that has only the
    NVIDIA driver: the runtime compiler NVRTC (libnvrtc / nvrtc64_*.dll with its builtins library) and the floating-point type headers
    NVRTC compiles the kernels against (cuda_fp16.h, cuda_bf16.h, cuda_fp8.h and their .hpp parts), as native assets of
    linux-x64, linux-arm64 and win-x64. All of them are listed as distributable in Attachment A of the CUDA Toolkit EULA (see
    docs/cuda.md, "Packaging and licensing"). Nothing is committed: the pinned archives of NVIDIA's redistributable server are
    downloaded and checked against the SHA-256 of the release manifest (redistrib_<CudaRedistVersion>.json) the first time they are
    needed. A build fetches only the archives of the build machine's runtime, and only when it has an NVIDIA driver or
    SharplightBundleCudaRuntime=true; pack fetches all of them.
    Projects in this repository reference this one with ReferenceOutputAssembly="false": the files are copied next to the application.
  -->
  <PropertyGroup>
    <Description>NVIDIA CUDA runtime compiler (NVRTC) and floating-point type headers for the Sharplight CUDA provider, as native assets for linux-x64, linux-arm64 and win-x64. Redistributed under the NVIDIA CUDA Toolkit EULA (Attachment A); no CUDA toolkit installation is needed, only the NVIDIA driver.</Description>
    <PackageTags>$(PackageTags);cuda;nvidia;nvrtc</PackageTags>
    <PackageLicenseExpression></PackageLicenseExpression>
    <PackageLicenseFile>LICENSE-NVIDIA-CUDA.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- NU5128: no lib/ folder by design (native assets only). -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <BeforePack>$(BeforePack);FetchCudaRedist</BeforePack>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Pinned CUDA 13.0 Update 2 redistributables (manifest https://developer.download.nvidia.com/compute/cuda/redist/redistrib_13.0.2.json).
      NVRTC 13.0 emits PTX ISA 9.0, which every driver of the CUDA 13 branch (R580 and later) compiles. Update the versions and the
      SHA-256 values from the manifest together.
    -->
    <CudaRedistVersion>13.0.2</CudaRedistVersion>
    <CudaNvrtcVersion>13.0.88</CudaNvrtcVersion>
    <CudaCudartVersion>13.0.96</CudaCudartVersion>
    <CudaRedistUrl>https://developer.download.nvidia.com/compute/cuda/redist</CudaRedistUrl>
    <CudaRedistDirectory>$(MSBuildThisFileDirectory)obj/cuda-redist/$(CudaRedistVersion)/</CudaRedistDirectory>
    <!-- The runtime of the build machine, whose files a build copies next to the application. -->
    <CudaHostRid Condition="'$(CudaHostRid)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">win-x64</CudaHostRid>
    <CudaHostRid Condition="'$(CudaHostRid)' == '' And $([MSBuild]::IsOSPlatform('Linux')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">linux-arm64</CudaHostRid>
    <CudaHostRid Condition="'$(CudaHostRid)' == '' And $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</CudaHostRid>
    <!-- Builds fetch only where an NVIDIA driver is installed (or on request); pack always fetches. -->
    <CudaDriverPresent Condition="Exists('/usr/lib/x86_64-linux-gnu/libcuda.so.1') Or Exists('/usr/lib/aarch64-linux-gnu/libcuda.so.1') Or Exists('/usr/lib64/libcuda.so.1') Or Exists('$(SystemRoot)\System32\nvcuda.dll')">true</CudaDriverPresent>
    <CudaRedistFetch Condition="'$(CudaRedistFetch)' == '' And '$(CudaHostRid)' != '' And ('$(CudaDriverPresent)' == 'true' Or '$(SharplightBundleCudaRuntime)' == 'true')">true</CudaRedistFetch>
    <CudaHeaders>cuda_fp16.h;cuda_fp16.hpp;cuda_bf16.h;cuda_bf16.hpp;cuda_fp8.h;cuda_fp8.hpp</CudaHeaders>
  </PropertyGroup>

  <ItemGroup>
    <!-- One archive per runtime and component: where it comes from, its SHA-256 and the files taken from it (archive path => file name). -->
    <CudaRedistArchive Include="nvrtc-linux-x64">
      <Rid>linux-x64</Rid>
      <Path>cuda_nvrtc/linux-x86_64/cuda_nvrtc-linux-x86_64-$(CudaNvrtcVersion)-archive.tar.xz</Path>
      <Sha256>00038aac08e1dba6f1933237dbfb217ac6452ae24fab970edcac808f103ca64b</Sha256>
      <Files>lib/libnvrtc.so.$(CudaNvrtcVersion)=libnvrtc.so.13|lib/libnvrtc-builtins.so.$(CudaNvrtcVersion)=libnvrtc-builtins.so.13.0|LICENSE=LICENSE-NVIDIA-CUDA.txt</Files>
    </CudaRedistArchive>
    <CudaRedistArchive Include="nvrtc-linux-arm64">
      <Rid>linux-arm64</Rid>
      <Path>cuda_nvrtc/linux-sbsa/cuda_nvrtc-linux-sbsa-$(CudaNvrtcVersion)-archive.tar.xz</Path>
      <Sha256>decf9977ab114ff195c8cdfce6fbc94aea4a62efdae628092cbb9fd1c31cda1a</Sha256>
      <Files>lib/libnvrtc.so.$(CudaNvrtcVersion)=libnvrtc.so.13|lib/libnvrtc-builtins.so.$(CudaNvrtcVersion)=libnvrtc-builtins.so.13.0|LICENSE=LICENSE-NVIDIA-CUDA.txt</Files>
    </CudaRedistArchive>
    <CudaRedistArchive Include="nvrtc-win-x64">
      <Rid>win-x64</Rid>
      <Path>cuda_nvrtc/windows-x86_64/cuda_nvrtc-windows-x86_64-$(CudaNvrtcVersion)-archive.zip</Path>
      <Sha256>8c50a52467826167e0dbe99936140c52d62272bfc5849fe2d6587d050c8c5d29</Sha256>
      <Files>bin/x64/nvrtc64_130_0.dll=nvrtc64_130_0.dll|bin/x64/nvrtc-builtins64_130.dll=nvrtc-builtins64_130.dll|LICENSE=LICENSE-NVIDIA-CUDA.txt</Files>
    </CudaRedistArchive>
    <!-- The floating-point type headers are the same on every platform: taken once, from the linux-x64 runtime archive. -->
    <CudaRedistArchive Include="headers">
      <Rid>any</Rid>
      <Path>cuda_cudart/linux-x86_64/cuda_cudart-linux-x86_64-$(CudaCudartVersion)-archive.tar.xz</Path>
      <Sha256>25b8071951baba827be1580b841d363464f6ee6c39f48d33a81646f90cc95ed1</Sha256>
      <Files>include/cuda_fp16.h=cuda_fp16.h|include/cuda_fp16.hpp=cuda_fp16.hpp|include/cuda_bf16.h=cuda_bf16.h|include/cuda_bf16.hpp=cuda_bf16.hpp|include/cuda_fp8.h=cuda_fp8.h|include/cuda_fp8.hpp=cuda_fp8.hpp</Files>
    </CudaRedistArchive>
  </ItemGroup>

  <ItemGroup>
    <_CudaHeaderNames Include="$(CudaHeaders)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- Downloads, verifies and extracts the archives this build or pack needs into $(CudaRedistDirectory)<rid>/. -->
  <Target Name="FetchCudaRedist" BeforeTargets="PrepareForBuild" Condition="'$(CudaRedistFetch)' == 'true' Or '$(_IsPacking)' == 'true'">
    <ItemGroup>
      <_CudaFetch Include="@(CudaRedistArchive)" Condition="'$(_IsPacking)' == 'true' Or '%(Rid)' == '$(CudaHostRid)' Or '%(Rid)' == 'any'">
        <Archive>$([System.IO.Path]::GetFileName('%(Path)'))</Archive>
        <Destination>$(CudaRedistDirectory)%(Rid)/</Destination>
      </_CudaFetch>
    </ItemGroup>
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="_FetchCudaArchive" Properties="CudaArchiveId=%(_CudaFetch.Identity);CudaArchivePath=%(_CudaFetch.Path);CudaArchiveSha256=%(_CudaFetch.Sha256);CudaArchiveFiles=%(_CudaFetch.Files);CudaArchiveName=%(_CudaFetch.Archive);CudaArchiveDestination=%(_CudaFetch.Destination)" />
  </Target>

  <Target Name="_FetchCudaArchive">
    <PropertyGroup>
      <_Marker>$(CudaArchiveDestination).$(CudaArchiveId).done</_Marker>
      <_Download>$(CudaRedistDirectory)download/</_Download>
    </PropertyGroup>
    <ItemGroup>
      <_Pair Include="$([MSBuild]::Unescape($(CudaArchiveFiles.Replace('|', ';'))))" />
      <_Wanted Include="@(_Pair)">
        <From>$([System.String]::Copy('%(Identity)').Split('=')[0])</From>
        <To>$([System.String]::Copy('%(Identity)').Split('=')[1])</To>
      </_Wanted>
    </ItemGroup>
    <PropertyGroup>
      <_Root>$([System.IO.Path]::GetFileName('$(CudaArchiveName)').Replace('.tar.xz', '').Replace('.zip', ''))</_Root>
    </PropertyGroup>
    <DownloadFile Condition="!Exists('$(_Marker)')" SourceUrl="$(CudaRedistUrl)/$(CudaArchivePath)" DestinationFolder="$(_Download)" DestinationFileName="$(CudaArchiveName)" Retries="3" />
    <GetFileHash Condition="!Exists('$(_Marker)')" Files="$(_Download)$(CudaArchiveName)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_Actual" />
    </GetFileHash>
    <Delete Condition="!Exists('$(_Marker)') And '$(_Actual.ToLowerInvariant())' != '$(CudaArchiveSha256)'" Files="$(_Download)$(CudaArchiveName)" />
    <Error Condition="!Exists('$(_Marker)') And '$(_Actual.ToLowerInvariant())' != '$(CudaArchiveSha256)'"
           Text="CUDA redistributable $(CudaArchiveName): the SHA-256 $(_Actual) does not match the pinned $(CudaArchiveSha256)." />
    <MakeDir Condition="!Exists('$(_Marker)')" Directories="$(_Download)x;$(CudaArchiveDestination)" />
    <Exec Condition="!Exists('$(_Marker)')" Command="tar --no-same-owner -xf &quot;$(CudaArchiveName)&quot; -C x @(_Wanted->'&quot;$(_Root)/%(From)&quot;', ' ')" WorkingDirectory="$(_Download)" />
    <Copy Condition="!Exists('$(_Marker)')" SourceFiles="@(_Wanted->'$(_Download)x/$(_Root)/%(From)')" DestinationFiles="@(_Wanted->'$(CudaArchiveDestination)%(To)')" />
    <RemoveDir Condition="!Exists('$(_Marker)')" Directories="$(_Download)x" />
    <Delete Condition="!Exists('$(_Marker)')" Files="$(_Download)$(CudaArchiveName)" />
    <Touch Condition="!Exists('$(_Marker)')" Files="$(_Marker)" AlwaysCreate="true" />
  </Target>

  <!-- The files of the build machine's runtime, copied next to every referencing application. -->
  <Target Name="AddCudaRedistContent" AfterTargets="FetchCudaRedist" BeforeTargets="AssignTargetPaths" Condition="'$(CudaRedistFetch)' == 'true' Or '$(_IsPacking)' == 'true'">
    <ItemGroup>
      <_CudaRuntimeFile Include="$(CudaRedistDirectory)$(CudaHostRid)/*" Exclude="$(CudaRedistDirectory)$(CudaHostRid)/LICENSE-NVIDIA-CUDA.txt" />
      <_CudaRuntimeFile Include="@(_CudaHeaderNames->'$(CudaRedistDirectory)any/%(Identity)')" />
      <None Include="@(_CudaRuntimeFile)" Link="%(Filename)%(Extension)" Visible="false" CopyToOutputDirectory="PreserveNewest" Condition="'$(CudaRedistFetch)' == 'true'" />
      <None Include="$(CudaRedistDirectory)linux-x64/*;$(CudaRedistDirectory)any/*" Exclude="$(CudaRedistDirectory)linux-x64/LICENSE-NVIDIA-CUDA.txt;$(CudaRedistDirectory)*/.*" Visible="false" Pack="true" PackagePath="runtimes/linux-x64/native/" Condition="'$(_IsPacking)' == 'true'" />
      <None Include="$(CudaRedistDirectory)linux-arm64/*;$(CudaRedistDirectory)any/*" Exclude="$(CudaRedistDirectory)linux-arm64/LICENSE-NVIDIA-CUDA.txt;$(CudaRedistDirectory)*/.*" Visible="false" Pack="true" PackagePath="runtimes/linux-arm64/native/" Condition="'$(_IsPacking)' == 'true'" />
      <None Include="$(CudaRedistDirectory)win-x64/*;$(CudaRedistDirectory)any/*" Exclude="$(CudaRedistDirectory)win-x64/LICENSE-NVIDIA-CUDA.txt;$(CudaRedistDirectory)*/.*" Visible="false" Pack="true" PackagePath="runtimes/win-x64/native/" Condition="'$(_IsPacking)' == 'true'" />
      <None Include="$(CudaRedistDirectory)linux-x64/LICENSE-NVIDIA-CUDA.txt" Visible="false" Pack="true" PackagePath="/" Condition="'$(_IsPacking)' == 'true'" />
    </ItemGroup>
  </Target>
</Project>
