{
  "$description": "Sharplight design tokens: the one source of the look of Sharplight Studio (Avalonia) and web UIs (CSS). Format: W3C design tokens ($type, $value). Generated into Studio's Themes/*.axaml and Models/GeneratedAccentPalettes.cs and into the Sharplight.DesignTokens package (CSS custom properties and the icon sprite) by tools/design-tokens; see docs/design-tokens.md.",
  "color": {
    "$type": "color",
    "accent": { "$value": "#7C5CFF", "$description": "Default accent (the Violet palette); apps replace it with the chosen palette." },
    "accent-secondary": { "$value": "#22C1EE", "$description": "Second colour of accent gradients and the second chart series." },
    "accent-soft-opacity": { "$type": "number", "$value": 0.16, "$description": "Opacity of the accent behind selected and highlighted items." },
    "success": { "$value": "#22C55E" },
    "warning": { "$value": "#F59E0B" },
    "danger": { "$value": "#EF4444" },
    "info": { "$value": "#38BDF8" },
    "success-text": { "$value": "#2DBE68", "$description": "Success text on a tinted badge." },
    "warning-text": { "$value": "#F0A82A", "$description": "Warning text on a tinted badge." }
  },
  "theme": {
    "dark": {
      "$type": "color",
      "app-background": { "$value": "#0E1015" },
      "sidebar": { "$value": "#12141A" },
      "surface": { "$value": "#171A21" },
      "surface-alt": { "$value": "#1E222B" },
      "surface-hover": { "$value": "#252A35" },
      "border-subtle": { "$value": "#272C37" },
      "text-primary": { "$value": "#E8EAF0" },
      "text-secondary": { "$value": "#A1A8B8" },
      "text-muted": { "$value": "#6B7385" },
      "code-background": { "$value": "#0A0C10" },
      "inline-code": { "$value": "#262B36" },
      "user-bubble": { "$value": "#232838" },
      "grid-line": { "$value": "#4A5263" }
    },
    "light": {
      "$type": "color",
      "app-background": { "$value": "#F5F6FA" },
      "sidebar": { "$value": "#ECEEF4" },
      "surface": { "$value": "#FFFFFF" },
      "surface-alt": { "$value": "#F1F3F8" },
      "surface-hover": { "$value": "#E7EAF2" },
      "border-subtle": { "$value": "#E0E3EB" },
      "text-primary": { "$value": "#141720" },
      "text-secondary": { "$value": "#4B5263" },
      "text-muted": { "$value": "#8A91A1" },
      "code-background": { "$value": "#F6F7FA" },
      "inline-code": { "$value": "#ECEEF4" },
      "user-bubble": { "$value": "#ECEAFE" },
      "grid-line": { "$value": "#B4BAC8" }
    }
  },
  "accent-palette": {
    "$description": "The accent palettes offered in the settings: the base colour, three lighter and three darker steps, and the secondary colour.",
    "violet": { "name": "Violet", "accent": "#7C5CFF", "light": ["#9479FF", "#AD97FF", "#C7B8FF"], "dark": ["#6646E6", "#5133C2", "#3D2499"], "secondary": "#22C1EE" },
    "ocean": { "name": "Ocean", "accent": "#2F80ED", "light": ["#4F95F0", "#76AEF4", "#A2C8F8"], "dark": ["#1F6AD0", "#1754AA", "#103F82"], "secondary": "#2DD4BF" },
    "emerald": { "name": "Emerald", "accent": "#10B981", "light": ["#34C796", "#5ED5AC", "#8FE3C6"], "dark": ["#0C9A6B", "#097A55", "#065C40"], "secondary": "#3B82F6" },
    "amber": { "name": "Amber", "accent": "#F59E0B", "light": ["#F7B036", "#F9C465", "#FBD898"], "dark": ["#D18406", "#A66904", "#7C4E03"], "secondary": "#EF4444" },
    "rose": { "name": "Rose", "accent": "#F43F5E", "light": ["#F6627C", "#F8879B", "#FBB0BE"], "dark": ["#D72A49", "#AE1F3A", "#83162B"], "secondary": "#A855F7" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "system-ui", "sans-serif"], "$description": "Studio embeds Inter (Avalonia.Fonts.Inter)." },
      "mono": { "$value": ["Cascadia Code", "JetBrains Mono", "Consolas", "DejaVu Sans Mono", "Menlo", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "h1": { "$value": "24px" },
      "h2": { "$value": "17px" },
      "h3": { "$value": "14px" },
      "big": { "$value": "26px", "$description": "Large figures (stat tiles)." },
      "body": { "$value": "14px", "$description": "Default text (the control font size of Avalonia's Fluent theme)." },
      "caption": { "$value": "12px" },
      "section": { "$value": "11px", "$description": "Upper-case section headers." },
      "mono": { "$value": "12.5px" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 }
    }
  },
  "radius": {
    "$type": "dimension",
    "tick": { "$value": "3px", "$description": "Progress bars." },
    "xs": { "$value": "4px" },
    "tag": { "$value": "5px" },
    "sm": { "$value": "6px", "$description": "Badges." },
    "segment": { "$value": "7px" },
    "md": { "$value": "8px", "$description": "Buttons, inputs, chips." },
    "nav": { "$value": "9px" },
    "lg": { "$value": "10px", "$description": "Insets, hints, callouts, list items, code blocks." },
    "xl": { "$value": "12px", "$description": "Cards and tables." },
    "avatar": { "$value": "14px" },
    "2xl": { "$value": "16px", "$description": "Composer and chat bubbles." }
  },
  "spacing": {
    "$type": "dimension",
    "$description": "The spacing scale (web UIs; Studio's layouts use the same steps).",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Elevation of floating surfaces (web UIs; Studio draws flat surfaces with borders).",
    "popover": { "$value": "0 8px 24px rgba(0, 0, 0, 0.28)" },
    "dialog": { "$value": "0 16px 48px rgba(0, 0, 0, 0.36)" }
  },
  "icons": { "$ref": "icons.json" }
}
