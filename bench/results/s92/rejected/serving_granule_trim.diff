+    [Fact]
+    public async Task PromptRowsPastAGranule_MoveToTheNextStep()
+    {
+        var d = new FakeBatchDecoder(4, maxBatchTokens: 400) { StepDelay = TimeSpan.FromMilliseconds(2) };
+        d.Script("a", loop: true);
+        using var e = Engine(d, new EngineOptions { MinBatchTokens = 0, BatchTokensGranule = 64, GranuleTrimRows = 16 });
+        var running = e.Submit(Req("r", max: 100000));
+        await T.WaitUntil(() => d.Steps.Count > 2);
+
+        // One decode row and a 70-row prompt: 71 rows, 7 past a granule, so the step takes 63 prompt rows and the next the other 7.
+        string prompt = new string('p', 69);
+        int start = d.Steps.Count;
+        var r = await e.Submit(Req(prompt, max: 2)).CompleteAsync();
+        int length = T.Prompt(prompt).Length;
+        var rows = d.Steps.Skip(start).Select(s => s.Sum(x => x.Rows)).ToList();
+        Assert.Equal("aa", r.Text);
+        Assert.Contains(64, rows);
+        Assert.DoesNotContain(rows, n => n == 1 + length);
+
+        // A prompt that ends further past the granule keeps its rows.
+        string wide = new string('q', 99);
+        start = d.Steps.Count;
+        await e.Submit(Req(wide, max: 2)).CompleteAsync();
+        Assert.Contains(d.Steps.Skip(start), s => s.Sum(x => x.Rows) == 1 + T.Prompt(wide).Length);
+        running.Cancel();
+        await running.CompleteAsync();
+    }
