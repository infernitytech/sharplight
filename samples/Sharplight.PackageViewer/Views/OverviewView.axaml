<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sharplight.PackageViewer.ViewModels"
             x:Class="Sharplight.PackageViewer.Views.OverviewView"
             x:DataType="vm:OverviewViewModel">
  <Grid ColumnDefinitions="5*,8,6*" Margin="0,8,0,0">
    <!-- Left: file facts and section table. -->
    <Grid RowDefinitions="Auto,Auto,Auto,*">
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,8">
        <Grid.Styles>
          <Style Selector="TextBlock">
            <Setter Property="Margin" Value="0,2,16,2" />
          </Style>
          <Style Selector="SelectableTextBlock">
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="TextWrapping" Value="Wrap" />
          </Style>
        </Grid.Styles>
        <TextBlock Grid.Row="0" Classes="caption" Text="File" />
        <SelectableTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Path}" />
        <TextBlock Grid.Row="1" Classes="caption" Text="Format version" />
        <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FormatVersion}" />
        <TextBlock Grid.Row="2" Classes="caption" Text="File size" />
        <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FileSize}" />
        <TextBlock Grid.Row="3" Classes="caption" Text="Reclaimable" />
        <SelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Reclaimable}" />
        <TextBlock Grid.Row="4" Classes="caption" Text="Model" />
        <SelectableTextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Model}" />
        <TextBlock Grid.Row="5" Classes="caption" Text="Graphs" />
        <SelectableTextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Graphs}" />
        <TextBlock Grid.Row="6" Classes="caption" Text="Weights" />
        <SelectableTextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Weights}" />
        <TextBlock Grid.Row="7" Classes="caption" Text="Artifact sets" />
        <SelectableTextBlock Grid.Row="7" Grid.Column="1" Text="{Binding ArtifactSets}" />
      </Grid>
      <TextBlock Grid.Row="1" Foreground="OrangeRed" TextWrapping="Wrap" Text="{Binding DefinitionError}"
                 IsVisible="{Binding DefinitionError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Grid.Row="2" Classes="heading" Text="Sections" />
      <DataGrid Grid.Row="3" ItemsSource="{Binding Sections}" IsReadOnly="True" GridLinesVisibility="Horizontal">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" />
          <DataGridTextColumn Header="Offset" Binding="{Binding Offset, StringFormat={}{0:N0}}" SortMemberPath="Offset" />
          <DataGridTextColumn Header="Length" Binding="{Binding Size}" SortMemberPath="Length" />
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>

    <!-- Right: properties and metadata. -->
    <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto,Auto">
      <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,4">
        <TextBlock Classes="heading" Margin="0,0,12,0" VerticalAlignment="Center" Text="Properties and metadata" />
        <TextBox Grid.Column="1" Watermark="Filter (key, value)" Text="{Binding Filter}" />
      </Grid>
      <DataGrid Grid.Row="1" ItemsSource="{Binding Values}" SelectedItem="{Binding SelectedValue}" IsReadOnly="True"
                GridLinesVisibility="Horizontal">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Source" Binding="{Binding Source}" />
          <DataGridTextColumn Header="Key" Binding="{Binding Key}" />
          <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Grid.Row="2" Classes="caption" Margin="0,4" Text="Selected value" />
      <TextBox Grid.Row="3" Height="140" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" FontFamily="monospace"
               Text="{Binding SelectedValue.Detail, FallbackValue=''}" />
    </Grid>
  </Grid>
</UserControl>
