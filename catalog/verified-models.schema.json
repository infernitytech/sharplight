              },
              "label": {
                "type": "string"
              },
              "format": {
                "type": "string",
                "enum": [
                  "gguf",
                  "safetensors",
                  "pytorch",
                  "diffusers",
                  "single-file",
                  "whisper-cpp",
                  "onnx",
                  "slm"
                ]
              },
              "quantization": {
                "type": [
                  "string",
                  "null"
                ]
