<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvm="using:Sharplight.Studio.ViewModels.Models"
             xmlns:conv="using:Sharplight.Studio.Converters"
             x:Class="Sharplight.Studio.Views.DiscoverView"
             x:DataType="mvm:HubSearchViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="ResultCard" x:DataType="mvm:HubResultViewModel">
      <StackPanel Margin="12,10" Spacing="3">
        <DockPanel>
          <Border DockPanel.Dock="Right" Classes="badge danger" IsVisible="{Binding Gated}" Margin="6,0,0,0"
                  ToolTip.Tip="Gated: accept the license on Hugging Face and set a token in the settings">
            <TextBlock Text="Gated" />
          </Border>
          <TextBlock DockPanel.Dock="Left" Classes="caption" Text="{Binding Owner, StringFormat='{}{0} /'}" VerticalAlignment="Center" Margin="0,0,6,0"
                     MaxWidth="160" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
        </DockPanel>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="14" VerticalAlignment="Top" Margin="12,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Path Classes="icon" Data="{StaticResource IconDownload}" Width="13" Height="13" />
              <TextBlock Classes="caption" Text="{Binding Downloads}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Path Classes="icon" Data="{StaticResource IconHeart}" Width="13" Height="13" />
              <TextBlock Classes="caption" Text="{Binding Likes}" />
            </StackPanel>
          </StackPanel>
          <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4">
            <Border Classes="badge vision" IsVisible="{Binding HasKind}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Path Classes="icon" Data="{Binding KindIcon, Converter={x:Static conv:IconConverter.Instance}}" Width="11" Height="11" />
                <TextBlock Text="{Binding KindTitle}" />
              </StackPanel>
            </Border>
            <Border Classes="badge accent">
              <TextBlock Text="{Binding Formats}" />
            </Border>
            <Border Classes="badge" IsVisible="{Binding License, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding License}" />
            </Border>
            <Border Classes="badge" IsVisible="{Binding Parameters, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding Parameters}" />
            </Border>
            <Border x:Name="RepositoryCompatibility" DataContext="{Binding Compatibility}" x:DataType="mvm:CompatibilityBadgeViewModel"
                    Classes="badge" Classes.ok="{Binding IsGood}" Classes.warn="{Binding IsWarning}" Classes.bad="{Binding IsBad}" ToolTip.Tip="{Binding ToolTip}">
              <TextBlock Text="{Binding Text}" />
            </Border>
            <TextBlock Classes="caption" Text="{Binding Variants}" VerticalAlignment="Center" />
          </WrapPanel>
        </DockPanel>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <Grid ColumnDefinitions="*,16,420" RowDefinitions="Auto,*" Margin="0,0,0,16">
    <StackPanel Grid.ColumnSpan="3" Spacing="8" Margin="0,0,0,12">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="accent" Command="{Binding SearchCommand}" Margin="8,0,0,0" Padding="16,7">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="icon" Data="{StaticResource IconSearch}" />
            <TextBlock Text="Search" />
          </StackPanel>
        </Button>
        <CheckBox DockPanel.Dock="Right" x:Name="ShowOnlySupported" Content="Supported only" IsChecked="{Binding ShowOnlySupported}" Margin="12,0,0,0"
                  ToolTip.Tip="Hide models and quantizations that Sharplight cannot run" />
        <TextBox x:Name="QueryBox" Text="{Binding Query}" PlaceholderText="Search Hugging Face, e.g. qwen3 gguf, gemma, whisper, flux">
          <TextBox.InnerLeftContent>
            <Path Classes="icon" Data="{StaticResource IconSearch}" Width="14" Height="14" Margin="10,0,0,0" />
          </TextBox.InnerLeftContent>
        </TextBox>
      </DockPanel>
      <WrapPanel x:Name="FilterBar" Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
        <ComboBox x:Name="TaskFilter" ItemsSource="{Binding Filters.Tasks}" SelectedItem="{Binding Filters.SelectedTask}" MinWidth="190" ToolTip.Tip="Model type">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="mvm:FilterOption">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox x:Name="FormatFilter" ItemsSource="{Binding Filters.Formats}" SelectedItem="{Binding Filters.SelectedFormat}" MinWidth="140" ToolTip.Tip="Format the repository provides">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="mvm:FilterOption">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox x:Name="QuantizationFilter" ItemsSource="{Binding Filters.Quantizations}" SelectedItem="{Binding Filters.SelectedQuantization}" MinWidth="160" ToolTip.Tip="Quantization family">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="mvm:FilterOption">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox x:Name="SizeFilter" ItemsSource="{Binding Filters.Sizes}" SelectedItem="{Binding Filters.SelectedSize}" MinWidth="150" ToolTip.Tip="Parameter count (models without a reported count always pass)">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="mvm:FilterOption">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox x:Name="LicenseFilter" ItemsSource="{Binding Filters.Licenses}" SelectedItem="{Binding Filters.SelectedLicense}" MinWidth="140" ToolTip.Tip="License">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="mvm:FilterOption">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox x:Name="GatedFilter" ItemsSource="{Binding Filters.GatedChoices}" SelectedItem="{Binding Filters.SelectedGated}" MinWidth="140" ToolTip.Tip="Gated models need accepting terms and a token">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="mvm:FilterOption">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox x:Name="SortFilter" ItemsSource="{Binding Filters.Sorts}" SelectedItem="{Binding Filters.SelectedSort}" MinWidth="160" ToolTip.Tip="Sort order">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="mvm:FilterOption">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <CheckBox x:Name="FitsFilter" Content="Fits this machine" IsChecked="{Binding Filters.FitsThisMachine}" VerticalAlignment="Center"
                  ToolTip.Tip="Hide models whose smallest download is likely larger than this machine's memory (approximate)" />
        <Button Classes="ghost small" Content="Reset filters" Command="{Binding Filters.ResetCommand}" IsVisible="{Binding Filters.HasActiveFilters}" VerticalAlignment="Center" />
      </WrapPanel>
    </StackPanel>

    <Border Grid.Row="1" Classes="card" Padding="6">
      <Panel>
        <!-- Search results -->
        <DockPanel IsVisible="{Binding IsShowingResults}">
          <DockPanel DockPanel.Dock="Bottom" Margin="10,6">
            <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" Width="80" IsVisible="{Binding IsSearching}" VerticalAlignment="Center" />
            <StackPanel Spacing="2">
              <TextBlock Classes="caption" Text="{Binding Status}" TextWrapping="Wrap" />
              <TextBlock Classes="caption" Text="{Binding HiddenResultsText}" TextWrapping="Wrap"
                         IsVisible="{Binding HiddenResultsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </DockPanel>
          <ListBox Classes="plain" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" ItemTemplate="{StaticResource ResultCard}" />
        </DockPanel>

        <!-- Highlights, while nothing is searched -->
        <ScrollViewer x:Name="Highlights" IsVisible="{Binding IsShowingHighlights}" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="18" Margin="6,8,6,10">
            <TextBlock Classes="h2" Text="{Binding HighlightsHeading}" Margin="6,0,6,0" />
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoadingHighlights}" Margin="6,0" />
            <TextBlock Classes="caption" Text="{Binding HighlightsStatus}" TextWrapping="Wrap" Margin="6,0"
                       IsVisible="{Binding HighlightsStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ItemsControl ItemsSource="{Binding Highlights}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="18" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="mvm:HighlightSectionViewModel">
                  <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="6,0,6,4">
                      <TextBlock Classes="h3" Text="{Binding Title}" VerticalAlignment="Center" />
                      <TextBlock Classes="caption" Text="{Binding Description}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="mvm:HubResultViewModel">
                          <Button Classes="resultcard" Classes.selected="{Binding IsSelected}" Click="OnHighlightClick">
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ResultCard}" />
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="caption" Margin="6,0" TextWrapping="Wrap" IsVisible="{Binding !IsLoadingHighlights}"
                       Text="Models whose architecture Sharplight supports, from Hugging Face. Search to find any other model." />
          </StackPanel>
        </ScrollViewer>
      </Panel>
    </Border>

    <!-- Details -->
    <Border Grid.Row="1" Grid.Column="2" Classes="card">
      <Panel>
        <StackPanel IsVisible="{Binding !HasSelection}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
          <Path Classes="icon huge" Data="{StaticResource IconModels}" HorizontalAlignment="Center" />
          <TextBlock Classes="muted" Text="Select a model to see its quantizations." HorizontalAlignment="Center" />
        </StackPanel>
        <DockPanel IsVisible="{Binding HasSelection}">
          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
            <TextBlock Classes="h2" Text="{Binding SelectedId}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="caption" Text="{Binding DetailFormat}" />
              <Button Classes="ghost small" Command="{Binding OpenOnHubCommand}" Padding="4,1">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="Open on Hugging Face" FontSize="12" />
                  <Path Classes="icon" Data="{StaticResource IconExternal}" Width="11" Height="11" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
          <Button DockPanel.Dock="Bottom" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding DownloadCommand}" Margin="0,8,0,0" Padding="0,9">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Classes="icon" Data="{StaticResource IconDownload}" />
              <TextBlock Text="Download, convert and add to the library" />
            </StackPanel>
          </Button>
          <!-- Approximate fit of the selected variant: a warning before downloading (the download stays possible) -->
          <Border DockPanel.Dock="Bottom" x:Name="DownloadFit" DataContext="{Binding SelectedFit}" x:DataType="mvm:FitBadgeViewModel" Margin="0,12,0,0"
                  IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}"
                  Classes="callout" Classes.ok="{Binding IsGood}" Classes.warn="{Binding IsWarning}" Classes.bad="{Binding IsBad}">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Path Classes="icon ok" Data="{StaticResource IconCheck}" Width="14" Height="14" IsVisible="{Binding IsGood}" />
                <Path Classes="icon warn" Data="{StaticResource IconWarning}" Width="14" Height="14" IsVisible="{Binding IsWarning}" />
                <Path Classes="icon bad" Data="{StaticResource IconWarning}" Width="14" Height="14" IsVisible="{Binding IsBad}" />
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <!-- Likely compatibility of the selected variant (architecture and weight formats); downloading stays possible -->
          <Border DockPanel.Dock="Bottom" x:Name="DownloadCompatibility" DataContext="{Binding SelectedCompatibility}" x:DataType="mvm:CompatibilityBadgeViewModel" Margin="0,12,0,0"
                  IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}"
                  Classes="callout" Classes.ok="{Binding IsGood}" Classes.warn="{Binding IsWarning}" Classes.bad="{Binding IsBad}">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Path Classes="icon ok" Data="{StaticResource IconCheck}" Width="14" Height="14" IsVisible="{Binding IsGood}" />
                <Path Classes="icon warn" Data="{StaticResource IconWarning}" Width="14" Height="14" IsVisible="{Binding IsWarning}" />
                <Path Classes="icon bad" Data="{StaticResource IconWarning}" Width="14" Height="14" IsVisible="{Binding IsBad}" />
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsLoadingDetails}" Margin="0,0,0,8" />
          <Border DockPanel.Dock="Top" x:Name="GatedNotice" Classes="callout warn" Margin="0,0,0,8"
                  IsVisible="{Binding GatedNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Classes="icon warn" Data="{StaticResource IconLock}" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0" />
              <TextBlock Text="{Binding GatedNotice}" FontSize="12" TextWrapping="Wrap" MaxWidth="340" />
            </StackPanel>
          </Border>
          <Border DockPanel.Dock="Top" x:Name="NoDownload" Classes="callout bad" Margin="0,0,0,8"
                  IsVisible="{Binding NoDownloadReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Classes="icon bad" Data="{StaticResource IconWarning}" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0" />
              <TextBlock Text="{Binding NoDownloadReason}" FontSize="12" TextWrapping="Wrap" MaxWidth="340" />
            </StackPanel>
          </Border>
          <StackPanel DockPanel.Dock="Top" x:Name="ComponentList" IsVisible="{Binding IsMultiComponent}" Spacing="2" Margin="0,0,0,10">
            <TextBlock Classes="section" Text="COMPONENTS (ONE MODEL)" Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{Binding Components}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="mvm:ComponentViewModel">
                  <DockPanel Margin="10,3">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" FontWeight="Medium" />
                    <TextBlock DockPanel.Dock="Right" Classes="caption" Text="{Binding Files}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" IsVisible="{Binding !IsMultiComponent}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
              <ProgressBar Classes="thin" IsIndeterminate="True" Width="40" VerticalAlignment="Center" IsVisible="{Binding IsEstimatingFit}" />
              <TextBlock Classes="caption" FontSize="11" Text="Fit on this machine is approximate"
                         ToolTip.Tip="Estimated before downloading from the file sizes and the model's dimensions, for the default load settings" />
            </StackPanel>
            <TextBlock Classes="section" Text="QUANTIZATIONS" />
          </DockPanel>
          <TextBlock DockPanel.Dock="Bottom" Classes="caption" Text="{Binding HiddenVariantsText}" TextWrapping="Wrap" Margin="10,6,10,0"
                     IsVisible="{Binding HiddenVariantsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <ListBox Classes="plain" ItemsSource="{Binding Variants}" SelectedItem="{Binding SelectedVariant}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="mvm:VariantViewModel">
                <DockPanel Margin="10,8">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" FontWeight="Medium" VerticalAlignment="Center" />
                  <Border DockPanel.Dock="Right" DataContext="{Binding Fit}" x:DataType="mvm:FitBadgeViewModel" Margin="0,0,10,0"
                          IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}"
                          Classes="badge" Classes.ok="{Binding IsGood}" Classes.warn="{Binding IsWarning}" Classes.bad="{Binding IsBad}" ToolTip.Tip="{Binding ToolTip}">
                    <TextBlock Text="{Binding Text}" />
                  </Border>
                  <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Tag}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Border Classes="badge accent" IsVisible="{Binding Recommended}">
                        <TextBlock Text="Recommended" />
                      </Border>
                      <Border Classes="badge vision" IsVisible="{Binding HasProjector}" ToolTip.Tip="Comes with a vision projector (mmproj)">
                        <TextBlock Text="Vision" />
                      </Border>
                      <Border Classes="badge tools" IsVisible="{Binding IsStored}">
                        <TextBlock Text="In library" />
                      </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Border DataContext="{Binding Compatibility}" x:DataType="mvm:CompatibilityBadgeViewModel"
                              IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}"
                              Classes="badge" Classes.ok="{Binding IsGood}" Classes.warn="{Binding IsWarning}" Classes.bad="{Binding IsBad}" ToolTip.Tip="{Binding ToolTip}">
                        <TextBlock Text="{Binding ShortText}" />
                      </Border>
                      <TextBlock Classes="caption" Text="{Binding Files}" VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Panel>
    </Border>
  </Grid>
</UserControl>
