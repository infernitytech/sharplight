<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Sharplight.Core/Sharplight.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test data keeps its output layout (Goldens/, Templates/, Fixtures/ next to the test assembly). -->
    <None Update="Templating/Goldens/*.json" Link="Goldens/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Templating/Templates/*.jinja" Link="Templates/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Tokenizers/Fixtures/*.json" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/FileWeights.cs" Link="Shared/FileWeights.cs" />
    <Compile Include="../Shared/EncodedFileRangeSource.cs" Link="Shared/EncodedFileRangeSource.cs" />
    <Compile Include="../Shared/ReversedBlockEncoding.cs" Link="Shared/ReversedBlockEncoding.cs" />
    <Compile Include="../Shared/FileRangeSource.cs" Link="Shared/FileRangeSource.cs" />
  </ItemGroup>
</Project>
